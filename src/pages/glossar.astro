---
/**
 * glossar.astro | Legaldefinitionen und Abkürzungen
 *
 * WCAG 3.1.3 Unusual Words and 3.1.4 Abbreviations (AAA): where the big codes
 * define their own terms, and what the abbreviations in law texts stand for.
 * Each law's page lists its own definitions; this page collects them.
 */
export const prerender = true;
import BaseLayout from '@layouts/BaseLayout.astro';
import tocData from '@data/toc.json';
import { glossaryEntries } from '@data/definitions';

const laws = (tocData as { laws: Array<{ slug: string; title: string; abbreviation: string }> }).laws;
const entries = glossaryEntries('de');
const groups = [...new Set(entries.map((e) => e.law))].map((slug) => {
	const law = laws.find((l) => l.slug === slug);
	return {
		slug,
		title: law?.title ?? slug,
		abbreviation: law?.abbreviation ?? slug.toUpperCase(),
		entries: entries.filter((e) => e.law === slug).sort((a, b) => a.term.localeCompare(b.term, 'de')),
	};
});

/** "__13" → "§ 13", "art_116" → "Art 116" */
const citation = (norm: string) => (norm.startsWith('art_') ? `Art ${norm.slice(4)}` : `§ ${norm.replace(/^__/, '')}`);

const abbreviations: Array<[string, string]> = [
	['§, §§', 'Paragraf, Paragrafen'],
	['Abs.', 'Absatz'],
	['Alt.', 'Alternative'],
	['Anl.', 'Anlage'],
	['Art', 'Artikel'],
	['BAnz.', 'Bundesanzeiger'],
	['BGBl.', 'Bundesgesetzblatt'],
	['Buchst.', 'Buchstabe'],
	['bzw.', 'beziehungsweise'],
	['f., ff.', 'folgende, fortfolgende (Paragrafen)'],
	['gem.', 'gemäß'],
	['Hs.', 'Halbsatz'],
	['i. d. F.', 'in der Fassung'],
	['i. S. d.', 'im Sinne des, im Sinne der'],
	['i. V. m.', 'in Verbindung mit'],
	['Nr.', 'Nummer'],
	['S.', 'Satz (in einer Vorschrift) oder Seite (im Bundesgesetzblatt)'],
	['u. a.', 'unter anderem'],
	['vgl.', 'vergleiche'],
	['z. B.', 'zum Beispiel'],
];
---

<BaseLayout title="Glossar" description="Legaldefinitionen der großen Gesetzbücher und Abkürzungen aus Gesetzestexten, mit Verweis auf die bestimmende Vorschrift.">
	<div class="content-container">
		<header class="content-header">
			<nav aria-label="Brotkrumen" class="breadcrumbs">
				<a href="/">Startseite</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">Glossar</span>
			</nav>
			<h1 class="content-title">Glossar</h1>
			<p class="content-lead">
				Was ein Gesetz unter einem Wort versteht, legt es oft selbst fest. Hier steht, wo das geschieht, und was die Abkürzungen in Gesetzestexten bedeuten.
			</p>
		</header>

		<div class="content-body">
			<section class="info-section" aria-labelledby="legaldefinitionen">
				<h2 id="legaldefinitionen">Legaldefinitionen</h2>
				<p>
					Neuere Gesetze fassen ihre Definitionen meist in einer Vorschrift mit dem Titel „Begriffsbestimmungen“ zusammen. Sie ist auf der Seite jedes Gesetzes oben unter „Begriffe, die dieses Gesetz bestimmt“ verlinkt. Die großen Gesetzbücher verteilen ihre Definitionen dagegen über den ganzen Text. Die wichtigsten davon stehen hier.
				</p>
				<p>
					Maßgeblich ist immer der Gesetzestext. Dasselbe Wort kann an anderer Stelle anders gemeint sein: Der Unternehmer im Werkvertrag (§ 631 BGB) ist nicht der Unternehmer aus § 14 BGB.
				</p>

				{
					groups.map((group) => (
						<section class="glossary-group" aria-labelledby={`gruppe-${group.slug}`}>
							<h3 id={`gruppe-${group.slug}`}>
								{group.title} ({group.abbreviation})
							</h3>
							<dl class="glossary-list">
								{group.entries.map((entry) => (
									<div class="glossary-item">
										<dt>{entry.term}</dt>
										<dd>
											<a href={`/${entry.law}/${entry.norm}`} class="glossary-link">
												{citation(entry.norm)} {group.abbreviation}
											</a>
										</dd>
									</div>
								))}
							</dl>
						</section>
					))
				}
			</section>

			<section class="info-section" aria-labelledby="abkuerzungen">
				<h2 id="abkuerzungen">Abkürzungen</h2>
				<p>
					Die Abkürzungen der Gesetze selbst, etwa BGB oder StGB, stehen im <a href="/gesetze">Verzeichnis der Gesetze</a> neben ihrem vollen Titel. Auf der Seite einer einzelnen Vorschrift nennt die Abkürzung den Titel, wenn man mit der Maus darauf zeigt.
				</p>
				<dl class="glossary-list">
					{
						abbreviations.map(([short, long]) => (
							<div class="glossary-item">
								<dt>{short}</dt>
								<dd>{long}</dd>
							</div>
						))
					}
				</dl>
			</section>
		</div>
	</div>
</BaseLayout>

<style>
	.content-container {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	.content-header {
		margin-bottom: var(--space-6);
		border-bottom: 1px solid var(--c-border);
		padding-bottom: var(--space-6);
	}

	.content-lead {
		font-size: var(--text-lg);
		color: var(--content-secondary);
		line-height: var(--leading-relaxed);
		max-inline-size: 80ch;
	}

	.content-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
	}

	.info-section h2 {
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 700;
		color: var(--content-primary);
		margin-bottom: var(--space-3);
	}

	.info-section h3 {
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: 700;
		color: var(--content-primary);
		margin-top: var(--space-6);
	}

	.info-section p {
		font-size: var(--text-base);
		color: var(--content-primary);
		line-height: var(--leading-relaxed);
		/* 1.4.8: 2.5em from a last line to the next first line, 80 characters a line */
		margin-bottom: calc(2.5em - 1lh);
		max-inline-size: 80ch;
	}

	.info-section a {
		color: var(--accent-default);
		text-decoration: underline;
	}

	.glossary-list {
		margin-top: var(--space-3);
		border-top: 1px solid var(--border-subtle);
	}

	.glossary-item {
		display: grid;
		grid-template-columns: minmax(10rem, 22rem) 1fr;
		gap: var(--space-4);
		align-items: center;
		min-block-size: 44px;
		border-bottom: 1px solid var(--border-subtle);
	}

	@media (max-width: 640px) {
		.glossary-item {
			grid-template-columns: 1fr;
			gap: 0;
			padding-block: var(--space-2);
		}
	}

	.glossary-item dt {
		font-weight: 600;
		color: var(--content-primary);
	}

	.glossary-item dd {
		margin: 0;
		color: var(--content-secondary);
	}

	/* 44px target (2.5.5) */
	.info-section .glossary-link {
		display: inline-flex;
		align-items: center;
		min-block-size: 44px;
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		font-weight: 600;
	}
</style>
