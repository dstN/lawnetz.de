---
/**
 * src/pages/aktualitaeten.astro | Aktualitätendienst des Bundesrechts
 *
 * Implements:
 * - Gesetze-im-Internet.de parity: Aktualitätendienst (aktuell.html)
 * - Displays recently amended or updated federal statutes
 * - Fast client-side filter
 * - Stand, Ausfertigung, and link to Table of Contents
 * - WCAG 2.2 AAA compliant
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { db } from '../db/index';
import * as schema from '../db/schema';
import { desc, isNotNull, eq, and } from 'drizzle-orm';
import fs from 'node:fs';
import path from 'node:path';

interface UpdatedLawItem {
	slug: string;
	abbreviation: string;
	title: string;
	latestChange?: string;
	enactmentDate?: string;
	normCount: number;
	lastUpdated: string;
}

let updatedLaws: UpdatedLawItem[] = [];
let lastSyncTimestamp: string = new Date().toLocaleDateString('de-DE');

// 1. Try fetching German laws from MySQL database
if (db) {
	try {
		const rows = await db
			.select({
				slug: schema.laws.slug,
				abbreviation: schema.laws.abbreviation,
				title: schema.laws.title,
				normCount: schema.laws.normCount,
				lastSyncedAt: schema.laws.lastSyncedAt,
			})
			.from(schema.laws)
			.where(and(isNotNull(schema.laws.lastSyncedAt), eq(schema.laws.language, 'de')))
			.orderBy(desc(schema.laws.lastSyncedAt))
			.limit(60);

		if (rows.length > 0) {
			updatedLaws = rows.map((r: any) => ({
				slug: r.slug,
				abbreviation: r.abbreviation || r.slug.toUpperCase(),
				title: r.title,
				normCount: r.normCount,
				lastUpdated: r.lastSyncedAt ? new Date(r.lastSyncedAt).toLocaleDateString('de-DE') : 'Aktuell',
			}));
			lastSyncTimestamp = updatedLaws[0]?.lastUpdated || lastSyncTimestamp;
		}
	} catch (err) {
		console.warn('[Aktualitäten] DB query failed:', err);
	}
}

// 2. Merge local priority laws (BGB, GG, StGB, etc.) if not already present
const lawsDir = path.resolve('src/data/laws');
if (fs.existsSync(lawsDir)) {
	const files = fs.readdirSync(lawsDir).filter((f) => f.endsWith('.json'));
	for (const file of files) {
		try {
			const content = JSON.parse(fs.readFileSync(path.join(lawsDir, file), 'utf-8'));
			if (!updatedLaws.some((l) => l.slug === content.slug)) {
				updatedLaws.push({
					slug: content.slug,
					abbreviation: content.abbreviation || content.slug.toUpperCase(),
					title: content.title,
					latestChange: content.latestChange,
					enactmentDate: content.enactmentDate,
					normCount: content.norms ? content.norms.length : 0,
					lastUpdated: content.fetchedAt ? new Date(content.fetchedAt).toLocaleDateString('de-DE') : 'Aktuell',
				});
			}
		} catch {}
	}
}

const pageTitle = 'Aktualitätendienst | Gesetzgebungs-Updates';
const description = 'Tagesaktuelle Übersicht über kürzlich geänderte und neu gefasste Bundesgesetze und Verordnungen.';
---

<BaseLayout title={pageTitle} description={description}>
	<div class="content-container">
		<header class="content-header">
			<nav aria-label="Brotkrumen" class="breadcrumbs">
				<a href="/">Startseite</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">Aktualitätendienst</span>
			</nav>

			<h1 class="content-title">Aktualitätendienst des Bundesrechts</h1>
			<p class="content-lead">
				Übersicht über kürzlich im Bundesgesetzblatt verkündete oder redaktionell aktualisierte Gesetze und Rechtsverordnungen.
			</p>
			<p class="sync-meta">
				Letzter amtlicher Datenabgleich: <strong>{lastSyncTimestamp}</strong>
			</p>
		</header>

		<!-- Quick filter -->
		<section class="filter-section" aria-label="Aktualisierte Gesetze filtern">
			<label for="update-filter" class="visually-hidden">Aktualisierte Gesetze filtern</label>
			<div class="filter-input-wrap">
				<svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<input
					id="update-filter"
					type="search"
					placeholder="In aktuellen Änderungen filtern (z. B. BGB, Datenschutz, Arbeitszeit)..."
					autocomplete="off"
					spellcheck="false"
				/>
				<span id="filter-count-badge" class="count-badge" aria-live="polite">
					{updatedLaws.length} Gesetze
				</span>
			</div>
		</section>

		<!-- List of updated statutes -->
		<section class="updates-list-section" aria-label="Liste der aktualisierten Gesetze">
			<ul id="updates-list" class="updates-list" role="list">
				{
					updatedLaws.map((law) => (
						<li class="update-card" data-search={`${law.abbreviation.toLowerCase()} ${law.title.toLowerCase()} ${law.slug.toLowerCase()}`}>
							<a href={`/${law.slug}/`} class="update-card-link">
								<div class="update-card-header">
									<span class="law-pill">{law.abbreviation}</span>
									<span class="update-date">{law.lastUpdated}</span>
								</div>
								<h2 class="update-law-title">{law.title}</h2>
								{law.latestChange && (
									<p class="update-meta-text">
										<span class="meta-label">Stand:</span> {law.latestChange}
									</p>
								)}
								<div class="update-card-footer">
									<span class="norm-count-tag">{law.normCount} Paragrafen/Artikel</span>
									<span class="view-link-text">Inhaltsverzeichnis aufrufen →</span>
								</div>
							</a>
						</li>
					))
				}
			</ul>
			<div id="no-filter-match" class="empty-state" hidden>
				<p>Keine geänderten Gesetze gefunden, die zu Ihrem Filterbegriff passen.</p>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.content-container {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	.breadcrumbs {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--text-sm);
		color: var(--c-content-secondary);
		margin-bottom: var(--space-4);
	}

	.breadcrumbs a {
		color: var(--c-content-secondary);
		text-decoration: none;
	}

	.breadcrumbs a:hover {
		color: var(--c-primary);
		text-decoration: underline;
	}

	.content-header {
		margin-bottom: var(--space-6);
		border-bottom: 1px solid var(--border-subtle);
		padding-bottom: var(--space-6);
	}

	.content-title {
		font-family: var(--font-display);
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--c-content);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--space-2);
	}

	@media (max-width: 860px) {
		.content-title {
			font-size: var(--text-2xl);
		}
	}

	.content-lead {
		font-size: var(--text-base);
		color: var(--c-content-secondary);
		line-height: var(--leading-normal);
		max-width: 65ch;
		margin-bottom: var(--space-3);
	}

	.sync-meta {
		font-size: var(--text-xs);
		color: var(--c-content-tertiary);
		margin: 0;
	}

	.sync-meta strong {
		color: var(--c-content-secondary);
		font-weight: 600;
	}

	/* Filter Section */
	.filter-section {
		margin-bottom: var(--space-6);
	}

	.filter-input-wrap {
		position: relative;
		display: flex;
		align-items: center;
		max-width: 36rem;
	}

	.search-icon {
		position: absolute;
		left: var(--space-3);
		color: var(--c-content-tertiary);
		pointer-events: none;
	}

	.filter-input-wrap input {
		width: 100%;
		height: 44px;
		padding: 0 6.5rem 0 2.5rem;
		border: 1px solid var(--border-default);
		border-radius: var(--radius-md);
		background: var(--surface-page);
		color: var(--c-content);
		font-size: var(--text-sm);
		transition: border-color var(--duration-fast), box-shadow var(--duration-fast);
	}

	.filter-input-wrap input:focus {
		border-color: var(--c-primary);
		box-shadow: 0 0 0 3px var(--accent-subtle);
		outline: none;
	}

	.count-badge {
		position: absolute;
		right: var(--space-2);
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--c-content-secondary);
		background: var(--surface-raised);
		padding: 3px 8px;
		border-radius: var(--radius-sm);
		border: 1px solid var(--border-subtle);
	}

	/* Updates List */
	.updates-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-3);
	}

	.update-card {
		background: var(--surface-page);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-md);
		transition: border-color var(--duration-fast), transform var(--duration-fast), box-shadow var(--duration-fast);
	}

	.update-card:hover {
		border-color: var(--c-primary);
		box-shadow: var(--shadow-sm);
		transform: translateY(-1px);
	}

	.update-card-link {
		display: block;
		padding: var(--space-4) var(--space-5);
		text-decoration: none;
		color: inherit;
	}

	.update-card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: var(--space-2);
	}

	.law-pill {
		display: inline-block;
		padding: 2px 8px;
		background: var(--accent-subtle);
		color: var(--accent-default);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: var(--text-xs);
		border-radius: var(--radius-sm);
		letter-spacing: 0.04em;
	}

	.update-date {
		font-size: var(--text-xs);
		color: var(--c-content-tertiary);
		font-family: var(--font-mono);
	}

	.update-law-title {
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--c-content);
		line-height: var(--leading-snug);
		margin-bottom: var(--space-2);
	}

	.update-meta-text {
		font-size: var(--text-xs);
		color: var(--c-content-secondary);
		line-height: var(--leading-normal);
		margin-bottom: var(--space-3);
	}

	.meta-label {
		color: var(--c-content-tertiary);
		font-weight: 600;
	}

	.update-card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: var(--text-xs);
		padding-top: var(--space-2);
		border-top: 1px solid var(--border-subtle);
	}

	.norm-count-tag {
		color: var(--c-content-tertiary);
	}

	.view-link-text {
		color: var(--c-primary);
		font-weight: 600;
	}

	.empty-state {
		padding: var(--space-8);
		text-align: center;
		color: var(--c-content-secondary);
		background: var(--surface-sunken);
		border-radius: var(--radius-md);
		border: 1px dashed var(--border-default);
	}
</style>

<script>
	const filterInput = document.getElementById('update-filter') as HTMLInputElement | null;
	const countBadge = document.getElementById('filter-count-badge');
	const emptyState = document.getElementById('no-filter-match');
	const cards = document.querySelectorAll<HTMLElement>('.update-card');

	if (filterInput && countBadge && cards.length > 0) {
		filterInput.addEventListener('input', () => {
			const query = filterInput.value.trim().toLowerCase();
			let visibleCount = 0;

			cards.forEach((card) => {
				const text = card.getAttribute('data-search') || '';
				if (!query || text.includes(query)) {
					card.style.display = '';
					visibleCount++;
				} else {
					card.style.display = 'none';
				}
			});

			countBadge.textContent = `${visibleCount} Gesetze`;
			if (emptyState) {
				emptyState.hidden = visibleCount > 0;
			}
		});
	}
</script>
