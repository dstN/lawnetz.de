		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-sm);
		font-size: var(--text-sm);
		font-weight: 500;
		cursor: pointer;
		min-height: 36px;
		transition: all var(--duration-fast);
	}

	.back-overview-btn:hover,
	.reset-search-btn:hover {
		background: var(--c-primary);
		color: #ffffff;
	}

	/* Law List */
	.law-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: 0;
		margin: 0;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
	}

	.law-item {
		border-radius: var(--radius-sm);
		transition: background-color var(--duration-fast);
		width: 100%;
		max-width: 100%;
		min-width: 0;
		overflow: hidden;
		box-sizing: border-box;
	}

	.law-item:hover,
	.law-item:focus-within {
		background: var(--c-surface-raised);
	}

	.law-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-4);
		min-height: 48px;
		text-decoration: none;
		color: var(--c-content);
		border-radius: var(--radius-sm);
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
		overflow: hidden;
	}

	.law-title-text {
		font-size: var(--text-base);
		line-height: var(--leading-normal);
		word-break: break-word;
		overflow-wrap: anywhere;
		min-width: 0;
		flex: 1;
		overflow: hidden;
	}

	.law-meta-tag {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		flex-shrink: 0;
	}

	.badge-trans {
		display: inline-block;
		font-size: var(--text-xs);
		font-weight: 600;
		color: #065f46;
		background: #d1fae5;
		padding: 2px 6px;
		border-radius: var(--radius-sm);
		white-space: nowrap;
	}

	:global([data-theme='dark']) .badge-trans {
		color: #34d399;
		background: rgba(6, 95, 70, 0.35);
	}

	.badge-slug {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--c-content-tertiary);
		background: var(--c-surface-sunken);
		padding: 2px 6px;
		border-radius: var(--radius-sm);
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.search-empty-state {
		text-align: center;
		padding: var(--space-10) var(--space-4);
		color: var(--c-content-secondary);
	}

	.empty-title {
		font-size: var(--text-lg);
		font-weight: 700;
		color: var(--c-content);
		margin-bottom: var(--space-2);
	}

	.empty-desc {
		font-size: var(--text-sm);
		max-width: 500px;
		margin: 0 auto;
		line-height: var(--leading-relaxed);
	}

	/* Load More Controls */
	.load-more-wrapper {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		margin-top: var(--space-6);
		margin-bottom: var(--space-8);
		padding: var(--space-4);
		background: var(--c-surface-raised);
		border: 1px solid var(--c-border);
		border-radius: var(--radius-md);
		text-align: center;
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
	}

	.load-more-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		max-width: 340px;
		min-height: 44px;
		padding: 0 var(--space-4);
		background: var(--c-primary);
		color: #ffffff;
		font-family: var(--font-body);
		font-size: var(--text-sm);
		font-weight: 600;
		border: 1px solid var(--c-primary);
		border-radius: var(--radius-sm);
		cursor: pointer;
		transition: all var(--duration-fast);
		touch-action: manipulation;
	}

	.load-more-btn:hover {
		filter: brightness(1.1);
	}

	.load-all-btn {
		background: transparent;
		border: none;
		color: var(--c-primary);
		font-size: var(--text-xs);
		font-weight: 500;
		cursor: pointer;
		padding: var(--space-1);
		text-decoration: underline;
		touch-action: manipulation;
	}

	.load-more-count {
		font-size: var(--text-xs);
		color: var(--c-content-tertiary);
		margin-top: 2px;
	}

	@media (max-width: 860px) {
		.directory-header {
			margin-bottom: var(--space-3);
		}

		.directory-view-wrapper {
			margin-top: var(--space-3);
		}

		#law-filter-input {
			padding: 0 36px 0 36px;
			font-size: var(--text-sm);
			height: 44px;
		}

		.filter-icon {
			left: 10px;
			width: 16px;
			height: 16px;
		}

		.filter-clear-btn {
			right: 4px;
		}

		.directory-title {
			font-size: var(--text-2xl);
		}

		.directory-subtitle {
			font-size: var(--text-sm);
			margin-bottom: var(--space-4);
		}

		.letter-view-info {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-2);
		}

		.essentials-grid {
			grid-template-columns: 1fr;
		}

		.letter-tiles-grid {
			grid-template-columns: repeat(3, 1fr);
		}

		.letter-view-header,
		.search-view-header {
			flex-direction: column;
			align-items: flex-start;
		}

		.law-link {
			padding: 10px 12px;
			gap: var(--space-2);
		}

		.law-title-text {
			font-size: var(--text-sm);
			line-height: 1.35;
		}
	}
</style>

<script>
	interface LawEntry {
		title: string;
		slug: string;
		xmlUrl: string;
		firstLetter: string;
	}

	const CHUNK_SIZE = 60;

	// DOM Elements
	const filterInput = document.getElementById('law-filter-input') as HTMLInputElement | null;
	const clearBtn = document.getElementById('filter-clear-btn') as HTMLButtonElement | null;
	const filterStatus = document.getElementById('filter-status') as HTMLParagraphElement | null;

	const letterTileBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.letter-tile-btn'));

	const overviewView = document.getElementById('overview-view') as HTMLElement | null;
	const letterView = document.getElementById('letter-view') as HTMLElement | null;
	const searchView = document.getElementById('search-view') as HTMLElement | null;
	const loadingView = document.getElementById('loading-view') as HTMLElement | null;
	const loadingText = document.getElementById('loading-text') as HTMLParagraphElement | null;

	const letterViewTitle = document.getElementById('letter-view-title') as HTMLHeadingElement | null;
	const letterViewBadge = document.getElementById('letter-view-badge') as HTMLSpanElement | null;
	const letterLawList = document.getElementById('letter-law-list') as HTMLUListElement | null;
	const btnBackOverview = document.getElementById('btn-back-overview') as HTMLButtonElement | null;

	const letterLoadMoreDiv = document.getElementById('letter-load-more') as HTMLDivElement | null;
	const btnLoadMoreLetter = document.getElementById('btn-load-more-letter') as HTMLButtonElement | null;
	const btnLoadAllLetter = document.getElementById('btn-load-all-letter') as HTMLButtonElement | null;
	const letterLoadMoreText = document.getElementById('load-more-text') as HTMLSpanElement | null;
	const letterLoadMoreCount = document.getElementById('load-more-count') as HTMLSpanElement | null;

	const searchViewTitle = document.getElementById('search-view-title') as HTMLHeadingElement | null;
	const searchLawList = document.getElementById('search-law-list') as HTMLUListElement | null;
	const searchEmptyState = document.getElementById('search-empty-state') as HTMLDivElement | null;
	const btnResetSearch = document.getElementById('btn-reset-search') as HTMLButtonElement | null;

	const searchLoadMoreDiv = document.getElementById('search-load-more') as HTMLDivElement | null;
	const btnLoadMoreSearch = document.getElementById('btn-load-more-search') as HTMLButtonElement | null;
	const btnLoadAllSearch = document.getElementById('btn-load-all-search') as HTMLButtonElement | null;
	const searchLoadMoreText = document.getElementById('load-more-search-text') as HTMLSpanElement | null;
	const searchLoadMoreCount = document.getElementById('load-more-search-count') as HTMLSpanElement | null;

	// In-memory cache for letters
	const cache = new Map<string, LawEntry[]>();
	let currentLetter: string | null = null;
	let currentMode: 'overview' | 'letter' | 'search' = 'overview';

	let currentLetterLaws: LawEntry[] = [];
	let currentLetterShown = 0;

	let currentSearchLaws: LawEntry[] = [];
	let currentSearchShown = 0;

	function appendLaws(container: HTMLUListElement, laws: LawEntry[], start: number, count: number) {
		const fragment = document.createDocumentFragment();
		const slice = laws.slice(start, start + count);

		for (const law of slice) {
			const li = document.createElement('li');
			li.className = 'law-item';

			const a = document.createElement('a');
			a.href = `/${encodeURIComponent(law.slug)}`;
			a.className = 'law-link';

			const titleSpan = document.createElement('span');
			titleSpan.className = 'law-title-text';
			titleSpan.textContent = law.title;

			const metaSpan = document.createElement('span');
			metaSpan.className = 'law-meta-tag';

			const badgeSpan = document.createElement('span');
			badgeSpan.className = 'badge-slug';
			badgeSpan.textContent = law.slug.toUpperCase();

			metaSpan.appendChild(badgeSpan);
			a.appendChild(titleSpan);
			a.appendChild(metaSpan);
			li.appendChild(a);
			fragment.appendChild(li);
		}

		container.appendChild(fragment);
	}

	function updateLetterLoadMoreUI() {
		if (!letterLoadMoreDiv) return;
		const total = currentLetterLaws.length;
		const remaining = total - currentLetterShown;
		if (remaining <= 0) {
			letterLoadMoreDiv.style.display = 'none';
		} else {
			letterLoadMoreDiv.style.display = 'flex';
			const nextChunk = Math.min(CHUNK_SIZE, remaining);
			if (letterLoadMoreText) letterLoadMoreText.textContent = `Load next ${nextChunk} laws (${remaining} remaining)`;
			if (btnLoadAllLetter) btnLoadAllLetter.textContent = `Show all ${total.toLocaleString('en-US')}`;
			if (letterLoadMoreCount) letterLoadMoreCount.textContent = `${currentLetterShown.toLocaleString('en-US')} of ${total.toLocaleString('en-US')} displayed`;
		}
	}

	function updateSearchLoadMoreUI() {
		if (!searchLoadMoreDiv) return;
		const total = currentSearchLaws.length;
		const remaining = total - currentSearchShown;
		if (remaining <= 0) {
			searchLoadMoreDiv.style.display = 'none';
		} else {
			searchLoadMoreDiv.style.display = 'flex';
			const nextChunk = Math.min(CHUNK_SIZE, remaining);
			if (searchLoadMoreText) searchLoadMoreText.textContent = `Load next ${nextChunk} results (${remaining} remaining)`;
			if (btnLoadAllSearch) btnLoadAllSearch.textContent = `Show all ${total.toLocaleString('en-US')}`;
			if (searchLoadMoreCount) searchLoadMoreCount.textContent = `${currentSearchShown.toLocaleString('en-US')} of ${total.toLocaleString('en-US')} displayed`;
		}
	}

	function showView(mode: 'overview' | 'letter' | 'search') {
		currentMode = mode;
		if (loadingView) loadingView.hidden = true;

		if (overviewView) overviewView.style.display = mode === 'overview' ? 'block' : 'none';
		if (letterView) letterView.style.display = mode === 'letter' ? 'block' : 'none';
		if (searchView) searchView.style.display = mode === 'search' ? 'block' : 'none';
	}

	async function loadLetter(letter: string, updateUrl = true) {
		currentLetter = letter;
		showView('letter');

		if (letterViewTitle) letterViewTitle.textContent = `Letter ${letter}`;
		if (filterStatus) filterStatus.textContent = `Loading Letter ${letter}...`;

		let laws = cache.get(letter);
		if (!laws) {
			if (loadingView) loadingView.hidden = false;
			if (letterLawList) letterLawList.innerHTML = '';
			if (letterLoadMoreDiv) letterLoadMoreDiv.style.display = 'none';

			try {
				const res = await fetch(`/api/laws?letter=${encodeURIComponent(letter)}`);
				if (!res.ok) throw new Error(`HTTP ${res.status}`);
				const data = await res.json();
				laws = data.laws || [];
				cache.set(letter, laws!);
			} catch (err) {
				console.error('[Laws] Failed to load letter:', err);
				laws = [];
			} finally {
				if (loadingView) loadingView.hidden = true;
			}
		}

		currentLetterLaws = laws || [];
		currentLetterShown = 0;

		if (letterViewBadge) {
			letterViewBadge.textContent = `${currentLetterLaws.length.toLocaleString('en-US')} laws`;
		}
		if (filterStatus) {
			filterStatus.textContent = `Letter ${letter}: ${currentLetterLaws.length.toLocaleString('en-US')} laws loaded`;
		}

		if (letterLawList) {
			letterLawList.innerHTML = '';
			const initialCount = Math.min(CHUNK_SIZE, currentLetterLaws.length);
			appendLaws(letterLawList, currentLetterLaws, 0, initialCount);
			currentLetterShown = initialCount;
		}

		updateLetterLoadMoreUI();

		if (updateUrl) {
			const newUrl = `/en/laws?letter=${encodeURIComponent(letter)}`;
			window.history.pushState({ mode: 'letter', letter }, '', newUrl);
		}
	}

	// Read initial SSR laws if present
	const ssrScript = document.getElementById('ssr-initial-laws');
	if (ssrScript && ssrScript.textContent) {
		try {
			const ssrData = JSON.parse(ssrScript.textContent);
			const urlParams = new URLSearchParams(window.location.search);
			const initChar = (urlParams.get('letter') || urlParams.get('buchstabe') || '').toUpperCase();
			if (initChar) {
				cache.set(initChar, ssrData);
				currentLetter = initChar;
				currentLetterLaws = ssrData;
				currentLetterShown = Math.min(CHUNK_SIZE, ssrData.length);
				updateLetterLoadMoreUI();
			}
		} catch (e) {}
	}

	letterTileBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			const letter = btn.getAttribute('data-letter');
			if (letter) loadLetter(letter);
		});
	});

	if (btnLoadMoreLetter && letterLawList) {
		btnLoadMoreLetter.addEventListener('click', () => {
			const nextCount = Math.min(CHUNK_SIZE, currentLetterLaws.length - currentLetterShown);
			appendLaws(letterLawList, currentLetterLaws, currentLetterShown, nextCount);
			currentLetterShown += nextCount;
			updateLetterLoadMoreUI();
		});
	}

	if (btnLoadAllLetter && letterLawList) {
		btnLoadAllLetter.addEventListener('click', () => {
			const remaining = currentLetterLaws.length - currentLetterShown;
			appendLaws(letterLawList, currentLetterLaws, currentLetterShown, remaining);
			currentLetterShown = currentLetterLaws.length;
			updateLetterLoadMoreUI();
		});
	}

	if (btnBackOverview) {
		btnBackOverview.addEventListener('click', () => {
			showView('overview');
			if (filterStatus) filterStatus.textContent = 'Select a letter or search directly for specific federal statutes';
			window.history.pushState({ mode: 'overview' }, '', '/en/laws');
		});
	}

	// Filter and live search
	let debounceTimer: ReturnType<typeof setTimeout> | null = null;
	if (filterInput) {
		filterInput.addEventListener('input', () => {
			const query = filterInput.value.trim();
			if (clearBtn) clearBtn.hidden = !query;

			if (debounceTimer) clearTimeout(debounceTimer);

			if (!query) {
				if (currentLetter) {
					showView('letter');
				} else {
					showView('overview');
				}
				return;
			}

			debounceTimer = setTimeout(async () => {
				showView('search');
				if (loadingView) loadingView.hidden = false;
				if (searchLawList) searchLawList.innerHTML = '';
				if (searchLoadMoreDiv) searchLoadMoreDiv.style.display = 'none';
				if (searchEmptyState) searchEmptyState.hidden = true;

				try {
					const res = await fetch(`/api/laws?q=${encodeURIComponent(query)}`);
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					const data = await res.json();
					currentSearchLaws = data.laws || [];
				} catch (err) {
					console.error('[Laws] Search failed:', err);
					currentSearchLaws = [];
				} finally {
					if (loadingView) loadingView.hidden = true;
				}

				if (filterStatus) {
					filterStatus.textContent = `${currentSearchLaws.length} results for "${query}"`;
				}

				if (currentSearchLaws.length === 0) {
					if (searchEmptyState) searchEmptyState.hidden = false;
				} else if (searchLawList) {
					const initialCount = Math.min(CHUNK_SIZE, currentSearchLaws.length);
					appendLaws(searchLawList, currentSearchLaws, 0, initialCount);
					currentSearchShown = initialCount;
					updateSearchLoadMoreUI();
				}
			}, 250);
		});
	}

	if (clearBtn && filterInput) {
		clearBtn.addEventListener('click', () => {
			filterInput.value = '';
			clearBtn.hidden = true;
			filterInput.focus();
			if (currentLetter) {
				showView('letter');
			} else {
				showView('overview');
			}
		});
	}

	if (btnResetSearch && filterInput) {
		btnResetSearch.addEventListener('click', () => {
			filterInput.value = '';
			if (clearBtn) clearBtn.hidden = true;
			showView('overview');
			window.history.pushState({ mode: 'overview' }, '', '/en/laws');
		});
	}

	// Browser back/forward navigation
	window.addEventListener('popstate', (e) => {
		const state = e.state;
		if (state && state.mode === 'letter' && state.letter) {
			loadLetter(state.letter, false);
		} else {
			showView('overview');
		}
	});
</script>
