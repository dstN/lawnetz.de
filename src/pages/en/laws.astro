		flex-wrap: wrap;
		gap: var(--space-3);
		padding-bottom: var(--space-3);
		border-bottom: 2px solid var(--c-border);
		margin-bottom: var(--space-4);
	}

	.letter-view-info {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.letter-view-title,
	.search-view-title {
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 700;
