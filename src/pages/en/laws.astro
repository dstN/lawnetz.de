---
/**
 * src/pages/en/laws.astro | All German Federal Laws & Regulations A–Z
 *
 * Implements:
 * - English UI directory of all 6,000+ German federal laws and regulations
 * - On-demand letter loading: eliminates DOM bloat, high performance
 * - Cross-reference to official English translations (BMJ Language Service)
 * - Curated key statutes essentials grid with English legal commentary
 * - Real-time client-side filter and letter pagination
 * - WCAG 2.2 AAA compliance
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import tocData from '../../data/toc.json';
import translationsData from '../../data/translations.json';

interface LawEntry {
	title: string;
	slug: string;
	xmlUrl: string;
	firstLetter: string;
}

interface TranslationEntry {
	slug: string;
	germanSlug: string;
	abbreviation: string;
	title: string;
}

const { laws, meta } = tocData as { meta: { count: number; fetchedAt: string; source: string }; laws: LawEntry[] };
const translations = translationsData as TranslationEntry[];

// Build lookup map of translations by German slug
const transMap = new Map<string, TranslationEntry>();
for (const t of translations) {
	if (t.germanSlug) {
		transMap.set(t.germanSlug.toLowerCase(), t);
	}
	transMap.set(t.slug.toLowerCase(), t);
}

// Pre-calculate counts per letter
const alphabet = ['#', ...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('')];
const letterCounts = new Map<string, number>();
alphabet.forEach((l) => letterCounts.set(l, 0));

for (const law of laws) {
	const char = law.firstLetter?.toUpperCase() || '#';
	const key = letterCounts.has(char) ? char : '#';
	letterCounts.set(key, (letterCounts.get(key) || 0) + 1);
}

// Check if a letter was requested via SSR searchParams
const rawLetterParam = Astro.url.searchParams.get('letter') || Astro.url.searchParams.get('buchstabe') || '';
const initialLetter = rawLetterParam ? (alphabet.includes(rawLetterParam.toUpperCase()) ? rawLetterParam.toUpperCase() : '#') : '';

let initialLaws: LawEntry[] = [];
if (initialLetter) {
	initialLaws = laws.filter((law) => {
		const char = law.firstLetter?.toUpperCase() || '#';
		return (alphabet.includes(char) ? char : '#') === initialLetter;
	});
}

const CHUNK_SIZE = 60;
const initialRenderedLaws = initialLetter ? initialLaws.slice(0, CHUNK_SIZE) : [];
const hasMoreInitial = initialLaws.length > CHUNK_SIZE;

// Curated Key German Statutes in English
const curatedStatutes = [
	{
		slug: 'bgb',
		abbr: 'BGB',
		title: 'Civil Code',
		germanTitle: 'Bürgerliches Gesetzbuch',
		desc: 'The foundational private law: general part, law of obligations, property, family, and succession.',
		category: 'Civil Law',
		enSlug: 'civil_code',
	},
	{
		slug: 'gg',
		abbr: 'GG',
		title: 'Basic Law',
		germanTitle: 'Grundgesetz',
		desc: 'The federal constitution of Germany guaranteeing inviolable human rights and democratic institutions.',
		category: 'Constitutional Law',
		enSlug: 'basic_law',
	},
	{
		slug: 'stgb',
		abbr: 'StGB',
		title: 'Criminal Code',
		germanTitle: 'Strafgesetzbuch',
		desc: 'Substantive penal law covering offenses, criminal liability, sentencing principles, and penalties.',
		category: 'Criminal Law',
		enSlug: 'criminal_code',
	},
	{
		slug: 'stvo_2013',
		abbr: 'StVO',
		title: 'Road Traffic Regulations',
		germanTitle: 'Straßenverkehrs-Ordnung',
		desc: 'Statutory traffic safety rules and obligations governing all users of German public roads.',
		category: 'Traffic Law',
		enSlug: null,
	},
	{
		slug: 'hgb',
		abbr: 'HGB',
		title: 'Commercial Code',
		germanTitle: 'Handelsgesetzbuch',
		desc: 'Special private law governing merchants, commercial transactions, and business companies.',
		category: 'Commercial Law',
		enSlug: 'commercial_code',
	},
	{
		slug: 'zpo',
		abbr: 'ZPO',
		title: 'Code of Civil Procedure',
		germanTitle: 'Zivilprozessordnung',
		desc: 'Rules of court and judicial procedure governing civil litigation before the courts of law.',
		category: 'Civil Procedure',
		enSlug: 'code_of_civil_procedure',
	},
	{
		slug: 'arbzg',
		abbr: 'ArbZG',
		title: 'Working Hours Act',
		germanTitle: 'Arbeitszeitgesetz',
		desc: 'Statutory protections governing maximum working times, mandatory rest breaks, and holiday work.',
		category: 'Employment Law',
		enSlug: 'working_hours_act',
	},
	{
		slug: 'ao_1977',
		abbr: 'AO',
		title: 'Fiscal Code',
		germanTitle: 'Abgabenordnung',
		desc: 'General administrative and substantive tax law governing assessment, audits, and tax litigation.',
		category: 'Tax Law',
		enSlug: null,
	},
];
---

<BaseLayout
	title={initialLetter ? `German Federal Laws starting with ${initialLetter}` : 'All German Laws A–Z'}
	description={`Complete directory of all ${meta.count.toLocaleString('en-US')} German federal statutes, codes, and regulations in full text.`}
>
	<div class="directory-container">
		<header class="directory-header">
			<nav aria-label="Breadcrumb" class="breadcrumbs">
				<a href="/en">Home</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">All German Laws A–Z</span>
				{initialLetter && (
					<>
						<span aria-hidden="true">/</span>
						<span id="breadcrumb-letter" aria-current="page">Letter {initialLetter}</span>
					</>
				)}
			</nav>

			<h1 class="directory-title">German Federal Laws and Regulations</h1>
			<p class="directory-subtitle">
				Official collection: <strong>{meta.count.toLocaleString('en-US')}</strong> German federal statutes and regulatory ordinances.
			</p>

			<!-- Instant Filter Bar -->
			<div class="filter-wrapper" role="search">
				<label for="law-filter-input" class="visually-hidden">Search laws by title or abbreviation</label>
				<div class="filter-input-box">
					<svg class="filter-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
					<input
						id="law-filter-input"
						type="search"
						placeholder="Search laws by German title or abbreviation (e.g. BGB, Civil Code, GG, StGB)..."
						autocomplete="off"
						spellcheck="false"
					/>
					<button id="filter-clear-btn" type="button" class="filter-clear-btn" aria-label="Clear input" hidden> ✕ </button>
				</div>
				<p id="filter-status" class="filter-status" aria-live="polite">
					{initialLetter
						? `Letter ${initialLetter}: ${initialLaws.length.toLocaleString('en-US')} laws loaded`
						: `Select a letter or search directly for specific federal statutes`}
				</p>
			</div>
		</header>

		<!-- Main Directory Views Container -->
		<div id="directory-view" class="directory-view-wrapper">
			<!-- Loading Indicator (Hidden by default) -->
			<div id="loading-view" class="loading-view" hidden aria-live="polite">
				<div class="loading-spinner" aria-hidden="true"></div>
				<p id="loading-text">Loading statutes...</p>
			</div>

			<!-- VIEW 1: Overview (Default when no letter is selected) -->
			<section id="overview-view" class="overview-view" style={initialLetter ? 'display: none;' : ''}>
				<!-- Curated Key Statutes Grid -->
				<div class="essentials-section">
					<div class="section-heading">
						<h2 class="section-title">Key German Statutes</h2>
						<p class="section-subtitle">Direct access to the most frequently consulted federal codes and statutes</p>
					</div>

					<div class="essentials-grid">
						{curatedStatutes.map((item) => (
							<a href={`/${item.slug}`} class="essential-card">
								<div class="card-top">
									<span class="card-badge">{item.abbr}</span>
									<span class="card-category">{item.category}</span>
								</div>
								<h3 class="card-title">{item.title}</h3>
								<p class="card-subtitle">{item.germanTitle}</p>
								<p class="card-desc">{item.desc}</p>
								<div class="card-footer">
									<span class="card-link-text">Open statute</span>
									<svg class="card-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<line x1="5" y1="12" x2="19" y2="12"></line>
										<polyline points="12 5 19 12 12 19"></polyline>
									</svg>
								</div>
							</a>
						))}
					</div>
				</div>

				<!-- Alphabet Tiles Grid -->
				<div class="tiles-section">
					<div class="section-heading">
						<h2 class="section-title">Browse German Laws by Letter</h2>
						<p class="section-subtitle">Select a letter to load the corresponding statutory registry on demand.</p>
					</div>

					<div class="letter-tiles-grid">
						{alphabet.map((letter) => {
							const count = letterCounts.get(letter) || 0;
							return (
								<button
									type="button"
									class="letter-tile-btn"
									data-letter={letter}
									aria-label={`Letter ${letter}: load ${count.toLocaleString('en-US')} laws`}
								>
									<span class="tile-char">{letter}</span>
									<span class="tile-count">{count.toLocaleString('en-US')} laws</span>
								</button>
							);
						})}
					</div>
				</div>
			</section>

			<!-- VIEW 2: Letter Laws List (Active when letter is selected) -->
			<section id="letter-view" class="letter-view" style={!initialLetter ? 'display: none;' : ''}>
				<div class="letter-view-header">
					<div class="letter-view-info">
						<button type="button" class="back-overview-btn" id="btn-back-overview">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="19" y1="12" x2="5" y2="12"></line>
								<polyline points="12 19 5 12 12 19"></polyline>
							</svg>
							<span>Back to Overview</span>
						</button>
						<h2 class="letter-view-title" id="letter-view-title">
							{initialLetter ? `Letter ${initialLetter}` : ''}
						</h2>
					</div>
					<span class="letter-view-badge" id="letter-view-badge">
						{initialLetter ? `${initialLaws.length.toLocaleString('en-US')} laws` : ''}
					</span>
				</div>

				<ul class="law-list" id="letter-law-list" role="list">
					{initialRenderedLaws.map((law) => {
						const trans = transMap.get(law.slug.toLowerCase());
						return (
							<li class="law-item">
								<a href={trans ? `/en/${trans.slug}/` : `/${encodeURIComponent(law.slug)}`} class="law-link">
									<span class="law-title-text">{law.title}</span>
									<span class="law-meta-tag">
										{trans && <span class="badge-trans" title="Official English translation available">EN Translation</span>}
										<span class="badge-slug">{law.slug.toUpperCase()}</span>
									</span>
								</a>
							</li>
						);
					})}
				</ul>

				<!-- Load More Pagination Controls for Letter -->
				<div id="letter-load-more" class="load-more-wrapper" style={hasMoreInitial ? '' : 'display: none;'}>
					<button type="button" id="btn-load-more-letter" class="load-more-btn">
						<span id="load-more-text">Load next {Math.min(CHUNK_SIZE, initialLaws.length - CHUNK_SIZE)} laws</span>
					</button>
					<button type="button" id="btn-load-all-letter" class="load-all-btn">
						Show all {initialLaws.length.toLocaleString('en-US')}
					</button>
					<span id="load-more-count" class="load-more-count">
						{hasMoreInitial ? `${initialRenderedLaws.length} of ${initialLaws.length.toLocaleString('en-US')} displayed` : ''}
					</span>
				</div>

				{initialLetter && (
					<script id="ssr-initial-laws" type="application/json" set:html={JSON.stringify(initialLaws)} />
				)}
			</section>

			<!-- VIEW 3: Search Results List (Active when typing in search bar) -->
			<section id="search-view" class="search-view" style="display: none;">
				<div class="search-view-header">
					<div class="search-view-info">
						<h2 class="search-view-title" id="search-view-title">Search Results</h2>
					</div>
					<button type="button" class="reset-search-btn" id="btn-reset-search">
						Reset search
					</button>
				</div>

				<ul class="law-list" id="search-law-list" role="list">
					<!-- Populated by JavaScript -->
				</ul>

				<!-- Load More Pagination Controls for Search -->
				<div id="search-load-more" class="load-more-wrapper" style="display: none;">
					<button type="button" id="btn-load-more-search" class="load-more-btn">
						<span id="load-more-search-text">Load more results</span>
					</button>
					<button type="button" id="btn-load-all-search" class="load-all-btn">
						Show all
					</button>
					<span id="load-more-search-count" class="load-more-count"></span>
				</div>

				<div id="search-empty-state" class="search-empty-state" hidden>
					<p class="empty-title">No statutes found</p>
					<p class="empty-desc">No federal statutes matched your query. Please check your spelling or choose a letter from the browse grid above.</p>
				</div>
			</section>
		</div>
	</div>
</BaseLayout>

<style>
	.directory-container {
		width: 100%;
		max-width: 100%;
		min-width: 0;
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	.breadcrumbs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-2);
		font-size: var(--text-sm);
		color: var(--c-content-tertiary);
		margin-bottom: var(--space-4);
	}

	.breadcrumbs a {
		color: var(--c-content-secondary);
		text-decoration: none;
	}

	.breadcrumbs a:hover {
		color: var(--c-primary);
		text-decoration: underline;
	}

	.directory-header {
		margin-bottom: var(--space-6);
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
	}

	.directory-title {
		font-family: var(--font-display);
		font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
		font-weight: 700;
		color: var(--c-content);
		line-height: var(--leading-tight);
		margin-bottom: var(--space-2);
	}

	.directory-subtitle {
		font-size: var(--text-base);
		color: var(--c-content-secondary);
		margin-bottom: var(--space-6);
		line-height: var(--leading-relaxed);
		text-wrap: pretty;
		overflow-wrap: break-word;
		word-break: break-word;
	}

	/* Filter Bar */
	.filter-wrapper {
		margin-bottom: var(--space-4);
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
	}

	.filter-input-box {
		position: relative;
		display: flex;
		align-items: center;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
	}

	.filter-icon {
		position: absolute;
		left: var(--space-3);
		color: var(--c-content-tertiary);
		pointer-events: none;
	}

	#law-filter-input {
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
		height: 48px;
		padding: 0 var(--space-10) 0 var(--space-10);
		font-size: var(--text-base);
		color: var(--c-content);
		background: var(--c-surface-raised);
		border: 1px solid var(--c-border);
		border-radius: var(--radius-md);
		outline: none;
		transition:
			border-color var(--duration-fast),
			box-shadow var(--duration-fast),
			background-color var(--duration-fast);
	}

	#law-filter-input:focus-visible {
		border-color: var(--c-primary);
		box-shadow: 0 0 0 3px var(--accent-focus);
		background: var(--c-surface);
	}

	.filter-clear-btn {
		position: absolute;
		right: var(--space-2);
		background: transparent;
		border: none;
		color: var(--c-content-tertiary);
		cursor: pointer;
		font-size: var(--text-base);
		padding: var(--space-2);
		min-width: 44px;
		min-height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-sm);
	}

	.filter-clear-btn:hover {
		color: var(--c-content);
	}

	.filter-status {
		margin-top: var(--space-2);
		font-size: var(--text-sm);
		color: var(--c-content-secondary);
		min-height: 20px;
	}

	/* Directory Views */
	.directory-view-wrapper {
		margin-top: var(--space-6);
		min-height: 300px;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
		overflow: hidden;
	}

	/* Loading Indicator */
	.loading-view {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: var(--space-8) var(--space-4);
		gap: var(--space-3);
		color: var(--c-content-secondary);
	}

	.loading-view[hidden] {
		display: none !important;
	}

	.loading-spinner {
		width: 32px;
		height: 32px;
		border: 3px solid var(--c-border);
		border-top-color: var(--c-primary);
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* Overview Section */
	.section-heading {
		margin-bottom: var(--space-4);
	}

	.section-title {
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 700;
		color: var(--c-content);
		margin-bottom: var(--space-1);
	}

	.section-subtitle {
		font-size: var(--text-sm);
		color: var(--c-content-secondary);
	}

	/* Essentials Grid */
	.essentials-section {
		margin-bottom: var(--space-8);
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
	}

	.essentials-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: var(--space-4);
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
	}

	.essential-card {
		display: flex;
		flex-direction: column;
		padding: var(--space-4);
		background: var(--c-surface-raised);
		border: 1px solid var(--c-border);
		border-radius: var(--radius-md);
		text-decoration: none;
		color: var(--c-content);
		transition:
			border-color var(--duration-fast),
			box-shadow var(--duration-fast),
			transform var(--duration-fast);
		height: 100%;
		box-sizing: border-box;
	}

	.essential-card:hover {
		border-color: var(--c-primary);
		box-shadow: var(--shadow-sm);
		transform: translateY(-1px);
	}

	.card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: var(--space-2);
	}

	.card-badge {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 700;
		color: var(--c-primary);
		background: var(--c-primary-subtle, rgba(26, 54, 93, 0.08));
		padding: 2px 6px;
		border-radius: var(--radius-sm);
	}

	.card-category {
		font-size: var(--text-xs);
		color: var(--c-content-tertiary);
	}

	.card-title {
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: 700;
		color: var(--c-content);
		margin-bottom: 2px;
	}

	.card-subtitle {
		font-size: var(--text-xs);
		font-style: italic;
		color: var(--c-content-tertiary);
		margin-bottom: var(--space-2);
	}

	.card-desc {
		font-size: var(--text-sm);
		color: var(--c-content-secondary);
		line-height: var(--leading-relaxed);
		flex: 1;
		margin-bottom: var(--space-3);
	}

	.card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: var(--space-2);
		border-top: 1px solid var(--c-border);
		color: var(--c-primary);
		font-size: var(--text-xs);
		font-weight: 600;
	}

	.card-arrow {
		transition: transform var(--duration-fast);
	}

	.essential-card:hover .card-arrow {
		transform: translateX(3px);
	}

	/* Tiles Section */
	.tiles-section {
		margin-bottom: var(--space-8);
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
	}

	.letter-tiles-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(105px, 1fr));
		gap: var(--space-2);
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
	}

	.letter-tile-btn {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: var(--space-3) var(--space-2);
		background: var(--c-surface-raised);
		border: 1px solid var(--c-border);
		border-radius: var(--radius-md);
		cursor: pointer;
		text-decoration: none;
		transition:
			background-color var(--duration-fast),
			border-color var(--duration-fast),
			transform var(--duration-fast);
		min-height: 64px;
		touch-action: manipulation;
	}

	.letter-tile-btn:hover {
		background: var(--c-surface);
		border-color: var(--c-primary);
		transform: translateY(-1px);
	}

	.tile-char {
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 700;
		color: var(--c-content);
	}

	.tile-count {
		font-size: var(--text-xs);
		color: var(--c-content-tertiary);
		margin-top: 2px;
	}

	/* Letter and Search Views */
	.letter-view-header,
	.search-view-header {
		display: flex;
		align-items: center;
