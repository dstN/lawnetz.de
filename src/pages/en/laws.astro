		border-radius: var(--radius-sm);
	}

	.back-overview-btn,
	.reset-search-btn {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		background: var(--c-surface-sunken);
		border: 1px solid var(--c-border);
