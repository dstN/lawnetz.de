---
/**
 * src/pages/en/updates.astro | Federal Law Amendments & Updates Service
 *
 * Implements:
 * - English parity with /aktualitaeten
 * - Displays recently amended or updated federal statutes
 * - Instant client-side filter
 * - WCAG 2.2 AAA compliance
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import { db } from '../../db/index';
import * as schema from '../../db/schema';
import { desc, isNotNull, eq, and } from 'drizzle-orm';
import fs from 'node:fs';
import path from 'node:path';

interface UpdatedLawItem {
	slug: string;
	abbreviation: string;
	title: string;
	latestChange?: string;
	enactmentDate?: string;
	normCount: number;
	lastUpdated: string;
}

let updatedLaws: UpdatedLawItem[] = [];
let lastSyncTimestamp: string = new Date().toLocaleDateString('en-GB');

// 1. Try fetching laws from database
if (db) {
	try {
		const rows = await db
			.select({
				slug: schema.laws.slug,
				abbreviation: schema.laws.abbreviation,
				title: schema.laws.title,
				normCount: schema.laws.normCount,
				lastSyncedAt: schema.laws.lastSyncedAt,
			})
			.from(schema.laws)
			.where(and(isNotNull(schema.laws.lastSyncedAt), eq(schema.laws.language, 'de')))
			.orderBy(desc(schema.laws.lastSyncedAt))
			.limit(60);

		if (rows.length > 0) {
			updatedLaws = rows.map((r) => ({
				slug: r.slug,
				abbreviation: r.abbreviation || r.slug.toUpperCase(),
				title: r.title,
				normCount: r.normCount,
				lastUpdated: r.lastSyncedAt ? new Date(r.lastSyncedAt).toLocaleDateString('en-GB') : 'Current',
			}));
			lastSyncTimestamp = updatedLaws[0]?.lastUpdated || lastSyncTimestamp;
		}
	} catch (err) {
		console.warn('[Updates] DB query failed:', err);
	}
}

// 2. Merge local priority laws (BGB, GG, StGB, etc.) if not already present
const lawsDir = path.resolve('src/data/laws');
if (fs.existsSync(lawsDir)) {
	const files = fs.readdirSync(lawsDir).filter((f) => f.endsWith('.json'));
	for (const file of files) {
		try {
			const content = JSON.parse(fs.readFileSync(path.join(lawsDir, file), 'utf-8'));
			if (!updatedLaws.some((l) => l.slug === content.slug)) {
				updatedLaws.push({
					slug: content.slug,
					abbreviation: content.abbreviation || content.slug.toUpperCase(),
					title: content.title,
					latestChange: content.latestChange,
					enactmentDate: content.enactmentDate,
					normCount: content.norms ? content.norms.length : 0,
					lastUpdated: content.fetchedAt ? new Date(content.fetchedAt).toLocaleDateString('en-GB') : 'Current',
				});
			}
		} catch {}
	}
}

const pageTitle = 'Recent Law Updates & Amendments';
const description = 'Official record of recently amended or editorially updated German federal statutes and regulations.';
---

<BaseLayout title={pageTitle} description={description}>
	<div class="content-container">
		<header class="content-header">
			<nav aria-label="Breadcrumb" class="breadcrumbs">
				<a href="/en">Home</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">Recent Updates</span>
			</nav>

			<h1 class="content-title">Federal Law Updates & Amendments</h1>
			<p class="content-lead">
				Official record of recently amended, promulgated, or editorially revised German federal acts and ordinances.
			</p>
			<p class="sync-meta">
				Last official synchronization: <strong>{lastSyncTimestamp}</strong>
			</p>
		</header>

		<!-- Quick filter -->
		<section class="filter-section" aria-label="Filter updated laws">
			<label for="update-filter" class="visually-hidden">Filter updated laws</label>
			<div class="filter-input-wrap">
				<svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<input
					id="update-filter"
					type="search"
					placeholder="Filter recent updates (e.g. BGB, data protection, working hours)..."
					autocomplete="off"
					spellcheck="false"
				/>
				<span id="filter-count-badge" class="count-badge" aria-live="polite">
					{updatedLaws.length} laws
				</span>
			</div>
		</section>

		<!-- List of updated statutes -->
		<section class="updates-list-section" aria-label="List of updated laws">
			<ul id="updates-list" class="updates-list" role="list">
				{
					updatedLaws.map((law) => (
						<li class="update-card" data-search={`${law.abbreviation.toLowerCase()} ${law.title.toLowerCase()} ${law.slug.toLowerCase()}`}>
							<a href={`/${law.slug}/`} class="update-card-link">
								<div class="update-card-header">
									<span class="law-pill">{law.abbreviation}</span>
									<span class="update-date">{law.lastUpdated}</span>
								</div>
								<h2 class="update-law-title">{law.title}</h2>

								<div class="update-meta-grid">
									{law.enactmentDate && (
										<div class="meta-item">
											<span class="meta-label">Enacted:</span>
											<span class="meta-val">{law.enactmentDate}</span>
										</div>
									)}
									{law.latestChange && (
										<div class="meta-item">
											<span class="meta-label">Last amendment:</span>
											<span class="meta-val">{law.latestChange}</span>
										</div>
									)}
									<div class="meta-item">
										<span class="meta-label">Sections:</span>
										<span class="meta-val">{law.normCount}</span>
									</div>
								</div>

								<div class="card-footer-action">
									<span>View statute table of contents</span>
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<line x1="5" y1="12" x2="19" y2="12"></line>
										<polyline points="12 5 19 12 12 19"></polyline>
									</svg>
								</div>
							</a>
						</li>
					))
				}
			</ul>

			<div id="no-results" class="no-results" hidden>
				<p>No laws match your filter criteria.</p>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.content-container {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	.breadcrumbs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-2);
		font-size: var(--text-sm);
		color: var(--c-content-tertiary);
		margin-bottom: var(--space-4);
	}

	.breadcrumbs a {
		color: var(--c-content-secondary);
		text-decoration: none;
	}

	.breadcrumbs a:hover {
		color: var(--c-primary);
		text-decoration: underline;
	}

	.content-header {
		margin-bottom: var(--space-6);
	}

	.content-title {
		font-family: var(--font-display);
		font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
		font-weight: 700;
		color: var(--c-content);
		line-height: var(--leading-tight);
		margin-bottom: var(--space-2);
	}

	.content-lead {
		font-size: var(--text-base);
		color: var(--c-content-secondary);
		line-height: var(--leading-relaxed);
		margin-bottom: var(--space-2);
	}

	.sync-meta {
		font-size: var(--text-xs);
		color: var(--c-content-tertiary);
	}

	.sync-meta strong {
		color: var(--c-content-secondary);
	}

	/* Filter Section */
	.filter-section {
		margin-bottom: var(--space-6);
	}

	.filter-input-wrap {
		position: relative;
		display: flex;
		align-items: center;
	}

	.search-icon {
		position: absolute;
		left: var(--space-3);
		color: var(--c-content-tertiary);
		pointer-events: none;
	}

	#update-filter {
		width: 100%;
		height: 48px;
		padding: 0 var(--space-10) 0 var(--space-10);
		font-size: var(--text-base);
		color: var(--c-content);
		background: var(--c-surface-raised);
		border: 1px solid var(--c-border);
		border-radius: var(--radius-md);
		outline: none;
		transition:
			border-color var(--duration-fast),
			box-shadow var(--duration-fast);
	}

	#update-filter:focus-visible {
		border-color: var(--c-primary);
		box-shadow: 0 0 0 3px var(--accent-focus);
	}

	.count-badge {
		position: absolute;
		right: var(--space-3);
		font-size: var(--text-xs);
		color: var(--c-content-tertiary);
		background: var(--c-surface-sunken);
		padding: 2px 8px;
		border-radius: var(--radius-full);
	}

	/* Updates List */
	.updates-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: var(--space-4);
	}

	.update-card {
		background: var(--c-surface-raised);
		border: 1px solid var(--c-border);
		border-radius: var(--radius-md);
		transition:
			border-color var(--duration-fast),
			box-shadow var(--duration-fast),
			transform var(--duration-fast);
	}

	.update-card:hover {
		border-color: var(--c-primary);
		box-shadow: var(--shadow-sm);
		transform: translateY(-1px);
	}

	.update-card-link {
		display: flex;
		flex-direction: column;
		padding: var(--space-4);
		text-decoration: none;
		color: var(--c-content);
		height: 100%;
		box-sizing: border-box;
	}

	.update-card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: var(--space-2);
	}

	.law-pill {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 700;
		color: var(--c-primary);
		background: var(--c-primary-subtle, rgba(26, 54, 93, 0.08));
		padding: 2px 6px;
		border-radius: var(--radius-sm);
	}

	.update-date {
		font-size: var(--text-xs);
		color: var(--c-content-tertiary);
	}

	.update-law-title {
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: 600;
		line-height: var(--leading-snug);
		margin-bottom: var(--space-3);
		color: var(--c-content);
		flex: 1;
	}

	.update-meta-grid {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-2) 0;
		border-top: 1px solid var(--c-border);
		border-bottom: 1px solid var(--c-border);
		margin-bottom: var(--space-3);
		font-size: var(--text-xs);
	}

	.meta-item {
		display: flex;
		gap: var(--space-2);
		overflow: hidden;
	}

	.meta-label {
		color: var(--c-content-tertiary);
		flex-shrink: 0;
	}

	.meta-val {
		color: var(--c-content-secondary);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.card-footer-action {
		display: flex;
		align-items: center;
		justify-content: space-between;
		color: var(--c-primary);
		font-size: var(--text-xs);
		font-weight: 600;
		padding-top: var(--space-1);
	}

	.no-results {
		text-align: center;
		padding: var(--space-8);
		color: var(--c-content-secondary);
	}

	@media (max-width: 640px) {
		.updates-list {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	const filterInput = document.getElementById('update-filter') as HTMLInputElement | null;
	const countBadge = document.getElementById('filter-count-badge') as HTMLSpanElement | null;
	const cards = Array.from(document.querySelectorAll<HTMLLIElement>('.update-card'));
	const noResults = document.getElementById('no-results') as HTMLDivElement | null;

	if (filterInput) {
		filterInput.addEventListener('input', () => {
			const query = filterInput.value.toLowerCase().trim();
			let visibleCount = 0;

			cards.forEach((card) => {
				const searchData = card.getAttribute('data-search') || '';
				const match = !query || searchData.includes(query);
				card.style.display = match ? '' : 'none';
				if (match) visibleCount++;
			});

			if (countBadge) {
				countBadge.textContent = `${visibleCount} laws`;
			}

			if (noResults) {
				noResults.hidden = visibleCount > 0;
			}
		});
	}
</script>
