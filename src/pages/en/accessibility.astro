---
/**
 * en/accessibility.astro | Digital Accessibility Statement (WCAG 2.2 AAA)
 */

export const prerender = true;

import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Accessibility Statement" description="Digital accessibility statement according to WCAG 2.2 Level AAA for LawNetz.de.">
	<div class="content-container">
		<header class="content-header">
			<nav aria-label="Breadcrumb" class="breadcrumbs">
				<a href="/en">Home</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">Accessibility</span>
			</nav>

			<h1 class="content-title">Accessibility Statement</h1>
			<p class="content-lead">
				This accessibility statement applies to the web offering of LawNetz.de and documents compliance with the Web Content Accessibility Guidelines (WCAG 2.2 Level AAA).
			</p>
		</header>

		<div class="content-body">
			<section class="info-section">
				<h2>1. Conformance Status</h2>
				<p>The goal is Conformance Level AAA of the Web Content Accessibility Guidelines (WCAG 2.2). Every change is tested automatically: with axe-core and with our own checks for the AAA criteria axe does not cover (target size, visual presentation, focus, keyboard, location). LawNetz does not fully meet one criterion and meets another only in part; both are listed in section 3.</p>
			</section>

			<section class="info-section">
				<h2>2. Implemented Accessibility Measures</h2>
				<dl class="measures-list">
					<div class="measure-item">
						<dt class="measure-title">Contrast Ratio ≥ 7:1 (AAA)</dt>
						<dd class="measure-desc">Text colors and interactive controls meet Level AAA contrast ratios in both light and dark appearances.</dd>
					</div>
					<div class="measure-item">
						<dt class="measure-title">Full Keyboard Operability</dt>
						<dd class="measure-desc">All functionality is operable without a mouse: skip links, visible focus indicators, and sequential shortcuts.</dd>
					</div>
					<div class="measure-item">
						<dt class="measure-title">Legible Typography</dt>
						<dd class="measure-desc">Self-hosted Atkinson Hyperlegible (designed specifically for visual impairments) and Lexend.</dd>
					</div>
					<div class="measure-item">
						<dt class="measure-title">Semantic HTML & ARIA</dt>
						<dd class="measure-desc">Clean heading hierarchy with a single H1 element per page, distinct landmarks, and screen-reader-optimized labels.</dd>
					</div>
					<div class="measure-item">
						<dt class="measure-title">44px Minimum Touch Targets</dt>
						<dd class="measure-desc">All buttons, links, and interactive elements feature a minimum touch target size of 44 × 44 pixels. Only links within running text are exempt.</dd>
					</div>
					<div class="measure-item">
						<dt class="measure-title">Visual Presentation</dt>
						<dd class="measure-desc">Lines of at most 80 characters, line spacing of at least 1.5, paragraph spacing of at least 2.5 lines, no justified text. Font sizes follow the text size set in the browser.</dd>
					</div>
					<div class="measure-item">
						<dt class="measure-title">Visible Focus</dt>
						<dd class="measure-desc">The focus outline is at least 2 pixels wide, contrasts at 3:1 or more, and is never clipped or covered.</dd>
					</div>
					<div class="measure-item">
						<dt class="measure-title">Terms and Abbreviations</dt>
						<dd class="measure-desc">Every law's page lists the sections in which the law defines its own terms. The <a href="/en/glossary">glossary</a> collects key definitions of the Civil Code and the Basic Law and explains abbreviations such as Art. or para.</dd>
					</div>
					<div class="measure-item">
						<dt class="measure-title">Zoom up to 400%</dt>
						<dd class="measure-desc">The layout remains fully readable and operable up to 400% zoom without horizontal scrolling or content loss.</dd>
					</div>
				</dl>
			</section>

			<section class="info-section">
				<h2>3. Content Not Fully Accessible</h2>
				<dl class="measures-list">
					<div class="measure-item">
						<dt class="measure-title">Reading Level (3.1.5, AAA): not met</dt>
						<dd class="measure-desc">Legal texts often require more reading ability than lower secondary education. LawNetz reproduces them unchanged, because only the wording counts, and offers no simplified versions.</dd>
					</div>
					<div class="measure-item">
						<dt class="measure-title">Unusual Words (3.1.3, AAA): partially met</dt>
						<dd class="measure-desc">Sections titled "Definitions" are found for every translated law. Definitions spread over the text are in the glossary only for the Civil Code and the Basic Law. Legal terms that no law defines are not explained, since explaining them would be legal advice.</dd>
					</div>
				</dl>
			</section>

			<section class="info-section">
				<h2>4. Feedback & Contact</h2>
				<p>If you encounter accessibility barriers on LawNetz, please contact us:</p>
				<p>
					Email: <a href="mailto:barrierefreiheit@lawnetz.de">barrierefreiheit@lawnetz.de</a>
				</p>
			</section>
		</div>
	</div>
</BaseLayout>

<style>
	.content-container {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	.breadcrumbs {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--text-sm);
		color: var(--c-content-secondary);
		margin-bottom: var(--space-4);
	}

	.breadcrumbs a {
		color: var(--c-content-secondary);
		text-decoration: none;
	}

	.breadcrumbs a:hover {
		color: var(--c-primary);
		text-decoration: underline;
	}

	.content-header {
		margin-bottom: var(--space-6);
		border-bottom: 1px solid var(--c-border);
		padding-bottom: var(--space-6);
	}

	.content-title {
		font-family: var(--font-display);
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--c-content);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--space-2);
	}

	@media (max-width: 860px) {
		.content-title {
			font-size: var(--text-2xl);
		}
	}

	.content-lead {
		font-size: var(--text-lg);
		color: var(--content-secondary);
		line-height: var(--leading-relaxed);
		/* 1.4.8: at most 80 characters a line, whatever the platform's text rendering */
		max-inline-size: 80ch;
	}

	.content-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
	}

	.info-section h2 {
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 700;
		color: var(--content-primary);
		margin-bottom: var(--space-3);
	}

	.info-section p {
		font-size: var(--text-base);
		color: var(--content-primary);
		line-height: var(--leading-relaxed);
		/* 1.4.8: 2.5em from a last line to the next first line, 80 characters a line */
		margin-bottom: calc(2.5em - 1lh);
		max-inline-size: 80ch;
	}

	.info-section a {
		color: var(--accent-default);
		text-decoration: underline;
	}

	.measures-list {
		margin-top: var(--space-6);
		border-top: 1px solid var(--border-subtle);
	}

	.measure-item {
		display: grid;
		grid-template-columns: 260px 1fr;
		gap: var(--space-4);
		padding: var(--space-4) 0;
		border-bottom: 1px solid var(--border-subtle);
		align-items: baseline;
	}

	@media (max-width: 640px) {
		.measure-item {
			grid-template-columns: 1fr;
			gap: var(--space-1);
		}
	}

	.measure-title {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--content-primary);
	}

	.measure-desc {
		font-size: var(--text-sm);
		color: var(--content-secondary);
		line-height: var(--leading-relaxed);
		margin: 0;
	}
</style>
