---
/**
 * suche.astro | Volltextsuche über Bundesgesetze
 *
 * Powered by Pagefind:
 * - 100% statisch & clientseitig (kein Backend, kein Tracking)
 * - Clientseitige Volltextsuche via Pagefind
 * - WCAG 2.2 AAA: aria-live Statusmeldung, Tastaturnavigation
 */

export const prerender = true;

import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Volltextsuche" description="Volltextsuche über alle Paragrafen und Artikel des deutschen Bundesrechts.">
	<div class="search-page-container">
		<header class="search-page-header">
			<nav aria-label="Brotkrumen" class="breadcrumbs">
				<a href="/">Startseite</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">Suche</span>
			</nav>

			<h1 class="search-title">Bundesrecht durchsuchen</h1>
			<p class="search-description">Clientseitige Volltextsuche über alle indizierten Gesetze und Verordnungen.</p>

			<!-- Main Search Form -->
			<form id="search-form" class="search-form" role="search" onsubmit="return false;">
				<label for="global-search-input" class="visually-hidden">Suchbegriff eingeben</label>
				<div class="search-input-group">
					<svg class="search-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
					<input id="global-search-input" type="search" placeholder="z. B. Sittenwidrigkeit, Kündigungsschutz, § 138 BGB, Art. 1 GG..." autocomplete="off" autofocus spellcheck="false" />
					<button id="search-clear-btn" type="button" class="search-clear-btn" aria-label="Suche zurücksetzen" hidden> ✕ </button>
				</div>
			</form>

			<!-- Live status region for screenreaders -->
			<p id="search-live-status" class="search-status" aria-live="polite" aria-atomic="true">Geben Sie einen Begriff ein, um die Volltextsuche zu starten.</p>
		</header>

		<!-- Search Results Container -->
		<section id="search-results-area" class="search-results-area" aria-label="Suchergebnisse">
			<div id="results-list" class="results-list" aria-live="polite" aria-busy="false">
				<!-- Injected via JavaScript -->
			</div>
		</section>

		<!-- Search Helper Guidance -->
		<section class="search-guidance" aria-label="Suchhinweise">
			<div class="guidance-content">
				<span class="guidance-label">Suchtipps:</span>
				<div class="guidance-items">
					<span class="guidance-item"><strong>Norm direkt:</strong> <code>§ 138 BGB</code> oder <code>Art. 1 GG</code></span>
					<span class="guidance-item"><strong>Schlagwörter:</strong> <em>Wucher</em>, <em>Kündigung</em>, <em>Notwehr</em></span>
					<span class="guidance-item"><strong>Datenschutz:</strong> Die Suche läuft lokal im Browser ohne Übermittlung von Suchanfragen</span>
				</div>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.search-page-container {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	.breadcrumbs {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--text-sm);
		color: var(--c-content-secondary);
		margin-bottom: var(--space-4);
	}

	.breadcrumbs a {
		color: var(--c-content-secondary);
		text-decoration: none;
	}

	.breadcrumbs a:hover {
		color: var(--c-primary);
		text-decoration: underline;
	}

	.search-page-header {
		margin-bottom: var(--space-6);
	}

	.search-title {
		font-family: var(--font-display);
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--c-content);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--space-2);
	}

	@media (max-width: 860px) {
		.search-title {
			font-size: var(--text-2xl);
		}
	}

	.search-description {
		font-size: var(--text-base);
		color: var(--c-content-secondary);
		margin-bottom: var(--space-6);
	}

	/* Search Input */
	.search-form {
		margin-bottom: var(--space-3);
	}

	.search-input-group {
		position: relative;
		display: flex;
		align-items: center;
	}

	.search-icon {
		position: absolute;
		left: var(--space-4);
		color: var(--content-tertiary);
		pointer-events: none;
	}

	#global-search-input {
		width: 100%;
		height: 56px;
		padding: 0 var(--space-12) 0 var(--space-12);
		font-size: var(--text-lg);
		color: var(--content-primary);
		background: var(--surface-raised);
		border: 2px solid var(--border-default);
		border-radius: var(--radius-md);
		outline: none;
		transition:
			border-color var(--duration-fast),
			box-shadow var(--duration-fast);
	}

	#global-search-input:focus-visible {
		border-color: var(--accent-default);
		box-shadow: 0 0 0 4px var(--accent-focus);
	}

	.search-clear-btn {
		position: absolute;
		right: var(--space-3);
		min-width: 44px;
		min-height: 44px;
		background: transparent;
		border: none;
		color: var(--content-tertiary);
		cursor: pointer;
		font-size: var(--text-lg);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.search-clear-btn:hover {
		color: var(--content-primary);
	}

	.search-status {
		font-size: var(--text-sm);
		color: var(--content-tertiary);
		min-height: 24px;
	}

	/* Results List | Apple HIG List Style */
	.search-results-area {
		margin-bottom: var(--space-10);
	}

	.results-list {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--border-subtle);
	}

	:global(.search-result-item) {
		padding: var(--space-4) var(--space-3);
		border-bottom: 1px solid var(--border-subtle);
		text-decoration: none;
		display: block;
		border-radius: var(--radius-sm);
		transition: background-color var(--duration-fast);
	}

	:global(.search-result-item:hover),
	:global(.search-result-item:focus-visible) {
		background-color: var(--surface-raised);
		outline: none;
	}

	:global(.search-result-title) {
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: 600;
		color: var(--content-primary);
		margin-bottom: var(--space-1);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
	}

	:global(.search-result-item:hover .search-result-title) {
		color: var(--accent-default);
	}

	:global(.search-result-snippet) {
		font-size: var(--text-sm);
		line-height: var(--leading-relaxed);
		color: var(--content-secondary);
	}

	:global(.search-result-snippet mark) {
		background: var(--accent-subtle);
		color: var(--accent-default);
		font-weight: 600;
		padding: 0 3px;
		border-radius: 2px;
	}

	:global(.search-result-item--direct) {
		background-color: var(--surface-raised);
		margin-bottom: var(--space-3);
		border: 1px solid var(--border-default);
		border-radius: var(--radius-md);
	}

	:global(.direct-badge) {
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--accent-default);
		background: var(--accent-subtle);
		padding: 2px 8px;
		border-radius: var(--radius-full);
	}

	/* Guidance */
	.search-guidance {
		margin-top: var(--space-10);
		padding-top: var(--space-6);
		border-top: 1px solid var(--border-subtle);
	}

	.guidance-content {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.guidance-label {
		font-size: var(--text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--content-tertiary);
	}

	.guidance-items {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3) var(--space-6);
		font-size: var(--text-xs);
		color: var(--content-secondary);
	}

	.guidance-item strong {
		color: var(--content-primary);
	}

	.guidance-item code {
		font-family: var(--font-mono);
		padding: 1px 4px;
		background: var(--surface-raised);
		border-radius: var(--radius-sm);
		color: var(--accent-default);
	}
</style>

<script is:inline>
	(function () {
		let pagefindInstance = null;
		const input = document.getElementById('global-search-input');
		const clearBtn = document.getElementById('search-clear-btn');
		const statusEl = document.getElementById('search-live-status');
		const resultsContainer = document.getElementById('results-list');

		async function loadPagefind() {
			if (pagefindInstance) return pagefindInstance;
			try {
				const pfPath = '/pagefind/pagefind.js';
				pagefindInstance = await import(pfPath);
				if (pagefindInstance && typeof pagefindInstance.init === 'function') {
					await pagefindInstance.init();
				}
				return pagefindInstance;
			} catch (err) {
				console.warn('[Pagefind] Index not yet available in dev mode:', err);
				return null;
			}
		}

		const POPULAR_LAWS = [
			{ slug: 'bgb', abbr: 'BGB', title: 'Bürgerliches Gesetzbuch' },
			{ slug: 'gg', abbr: 'GG', title: 'Grundgesetz für die Bundesrepublik Deutschland', isArticle: true },
			{ slug: 'stgb', abbr: 'StGB', title: 'Strafgesetzbuch' },
			{ slug: 'hgb', abbr: 'HGB', title: 'Handelsgesetzbuch' },
			{ slug: 'zpo', abbr: 'ZPO', title: 'Zivilprozessordnung' },
			{ slug: 'stpo', abbr: 'StPO', title: 'Strafprozessordnung' },
			{ slug: 'vwgo', abbr: 'VwGO', title: 'Verwaltungsgerichtsordnung' },
			{ slug: 'vwvfg', abbr: 'VwVfG', title: 'Verwaltungsverfahrensgesetz' },
			{ slug: 'bdsg_2018', abbr: 'BDSG', title: 'Bundesdatenschutzgesetz', aliases: ['bdsg'] },
			{ slug: 'urhg', abbr: 'UrhG', title: 'Urheberrechtsgesetz' },
			{ slug: 'ddg', abbr: 'DDG', title: 'Digitale-Dienste-Gesetz', aliases: ['tmg'] },
			{ slug: 'tkg_2021', abbr: 'TKG', title: 'Telekommunikationsgesetz', aliases: ['tkg'] },
			{ slug: 'arbzg', abbr: 'ArbZG', title: 'Arbeitszeitgesetz' },
			{ slug: 'kschg', abbr: 'KSchG', title: 'Kündigungsschutzgesetz' },
			{ slug: 'betrvg', abbr: 'BetrVG', title: 'Betriebsverfassungsgesetz' },
			{ slug: 'burlg', abbr: 'BUrlG', title: 'Bundesurlaubsgesetz' },
			{ slug: 'entgfg', abbr: 'EntgFG', title: 'Entgeltfortzahlungsgesetz' },
			{ slug: 'tzbfg', abbr: 'TzBfG', title: 'Teilzeit- und Befristungsgesetz' },
			{ slug: 'agg', abbr: 'AGG', title: 'Allgemeines Gleichbehandlungsgesetz' },
			{ slug: 'ao_1977', abbr: 'AO', title: 'Abgabenordnung', aliases: ['ao'] },
			{ slug: 'estg', abbr: 'EStG', title: 'Einkommensteuergesetz' },
			{ slug: 'ustg_1980', abbr: 'UStG', title: 'Umsatzsteuergesetz', aliases: ['ustg'] },
			{ slug: 'gewstg', abbr: 'GewStG', title: 'Gewerbesteuergesetz' },
			{ slug: 'gmbhg', abbr: 'GmbHG', title: 'Gesetz betreffend die Gesellschaften mit beschränkter Haftung' },
			{ slug: 'aktg', abbr: 'AktG', title: 'Aktiengesetz' },
			{ slug: 'inso', abbr: 'InsO', title: 'Insolvenzordnung' },
			{ slug: 'uwg_2004', abbr: 'UWG', title: 'Gesetz gegen den unlauteren Wettbewerb', aliases: ['uwg'] },
			{ slug: 'gwb', abbr: 'GWB', title: 'Gesetz gegen Wettbewerbsbeschränkungen' },
			{ slug: 'stvo_2013', abbr: 'StVO', title: 'Straßenverkehrs-Ordnung', aliases: ['stvo'] },
			{ slug: 'stvg', abbr: 'StVG', title: 'Straßenverkehrsgesetz' },
			{ slug: 'bimschg', abbr: 'BImSchG', title: 'Bundes-Immissionsschutzgesetz' },
			{ slug: 'aufenthg_2004', abbr: 'AufenthG', title: 'Aufenthaltsgesetz', aliases: ['aufenthg'] },
			{ slug: 'sgb_1', abbr: 'SGB I', title: 'Sozialgesetzbuch Erstes Buch', aliases: ['sgb1'] },
			{ slug: 'sgb_4', abbr: 'SGB IV', title: 'Sozialgesetzbuch Viertes Buch', aliases: ['sgb4'] },
			{ slug: 'sgb_5', abbr: 'SGB V', title: 'Sozialgesetzbuch Fünftes Buch', aliases: ['sgb5'] },
			{ slug: 'sgb_9_2018', abbr: 'SGB IX', title: 'Sozialgesetzbuch Neuntes Buch', aliases: ['sgb9'] },
			{ slug: 'milog', abbr: 'MiLoG', title: 'Mindestlohngesetz' },
			{ slug: 'muschg_2018', abbr: 'MuSchG', title: 'Mutterschutzgesetz', aliases: ['muschg'] },
			{ slug: 'beeg', abbr: 'BEEG', title: 'Bundeselterngeld- und Elternzeitgesetz' },
			{ slug: 'gwg_2017', abbr: 'GwG', title: 'Geldwäschegesetz', aliases: ['gwg'] },
			{ slug: 'geschgehg', abbr: 'GeschGehG', title: 'Geschäftsgeheimnisgesetz' },
			{ slug: 'wphg', abbr: 'WpHG', title: 'Wertpapierhandelsgesetz' },
			{ slug: 'famfg', abbr: 'FamFG', title: 'Gesetz über das Verfahren in Familiensachen' },
			{ slug: 'gvg', abbr: 'GVG', title: 'Gerichtsverfassungsgesetz' },
			{ slug: 'jgg', abbr: 'JGG', title: 'Jugendgerichtsgesetz' },
			{ slug: 'owig_1968', abbr: 'OWiG', title: 'Gesetz über Ordnungswidrigkeiten', aliases: ['owig'] },
		];

		function findLaw(raw) {
			const s = raw.trim().toLowerCase();
			return POPULAR_LAWS.find(function (l) {
				return (
					l.abbr.toLowerCase() === s ||
					l.slug.toLowerCase() === s ||
					(l.aliases &&
						l.aliases.some(function (a) {
							return a.toLowerCase() === s;
						}))
				);
			});
		}

		function parseDirectNorm(rawQuery) {
			let q = (rawQuery || '').trim();
			if (!q) return null;

			q = q.replace(/^([§\s]*\d+)([a-zäöüß]{2,})$/i, '$1 $2');
			const cleaned = q
				.replace(/\s+(?:abs(?:atz)?\.?\s*\d+|s(?:atz)?\.?\s*\d+|nr\.?\s*\d+|i{1,3}|iv|v)\b/gi, ' ')
				.replace(/\s+/g, ' ')
				.trim();

			const m1 = cleaned.match(/^(?:§+|art\.?|artikel)?\s*(\d+[a-z]?)\s*(?:im|in|des)?\s*([a-zäöüß0-9_\s]+)$/i);
			if (m1) {
				const num = m1[1].toLowerCase();
				const found = findLaw(m1[2]);
				if (found) {
					const isArt = found.isArticle || found.slug === 'gg';
					const normSlug = isArt ? 'art_' + num : '__' + num;
					const label = found.abbr + ' ' + (isArt ? 'Art.' : '§') + ' ' + m1[1].toUpperCase();
					return { url: '/' + found.slug + '/' + normSlug, label: label, lawTitle: found.title };
				}
			}

			const m2 = cleaned.match(/^([a-zäöüß0-9_\s]+?)\s*(?:§+|art\.?|artikel)?\s*(\d+[a-z]?)$/i);
			if (m2) {
				const num = m2[2].toLowerCase();
				const found = findLaw(m2[1]);
				if (found) {
					const isArt = found.isArticle || found.slug === 'gg';
					const normSlug = isArt ? 'art_' + num : '__' + num;
					const label = found.abbr + ' ' + (isArt ? 'Art.' : '§') + ' ' + m2[2].toUpperCase();
					return { url: '/' + found.slug + '/' + normSlug, label: label, lawTitle: found.title };
				}
			}

			return null;
		}

		async function runSearch(query) {
			const q = (query || '').trim();
			if (clearBtn) clearBtn.hidden = q.length === 0;

			if (!q) {
				if (resultsContainer) resultsContainer.innerHTML = '';
				if (statusEl) statusEl.textContent = 'Geben Sie einen Begriff ein, um die Volltextsuche zu starten.';
				return;
			}

			if (statusEl) statusEl.textContent = 'Suche nach „' + q + '“…';

			// Check direct norm jump or direct law match
			const direct = parseDirectNorm(q);
			const exactLaw = findLaw(q);
			let directHtml = '';

			if (direct) {
				directHtml += '<a href="' + direct.url + '" class="search-result-item search-result-item--direct">' + '<h3 class="search-result-title"><span>' + direct.label + ' | ' + direct.lawTitle + '</span><span class="direct-badge">Direkt</span></h3>' + '<p class="search-result-snippet">Offiziellen Volltext dieser Norm direkt aufrufen ↗</p>' + '</a>';
			} else if (exactLaw) {
				directHtml += '<a href="/' + exactLaw.slug + '" class="search-result-item search-result-item--direct">' + '<h3 class="search-result-title"><span>' + exactLaw.abbr + ' | ' + exactLaw.title + '</span><span class="direct-badge">Gesetz</span></h3>' + '<p class="search-result-snippet">Inhaltsübersicht und Paragrafen dieses Bundesgesetzes ansehen ↗</p>' + '</a>';
			}

			const pf = await loadPagefind();
			if (!pf) {
				if (resultsContainer && directHtml) {
					resultsContainer.innerHTML = directHtml;
					if (statusEl) statusEl.textContent = 'Direkttreffer gefunden.';
				} else if (statusEl) {
					statusEl.textContent = 'Der Volltext-Suchindex wird gerade initialisiert...';
				}
				return;
			}

			const searchResult = await pf.search(q);
			const total = searchResult.results ? searchResult.results.length : 0;

			if (total === 0) {
				if (resultsContainer) {
					resultsContainer.innerHTML = directHtml;
				}
				if (statusEl) {
					statusEl.textContent = directHtml ? 'Direkt-Treffer für „' + q + '“' : 'Keine Treffer für „' + q + '“ gefunden. Prüfen Sie die Schreibweise.';
				}
				return;
			}

			if (statusEl) {
				statusEl.textContent = total + (total === 1 ? ' Treffer' : ' Treffer') + ' für „' + q + '“' + (directHtml ? ' (inkl. Direkttreffer)' : '');
			}

			// Render top 25 results
			const topResults = searchResult.results.slice(0, 25);
			const dataPromises = topResults.map(function (r) {
				return r.data();
			});
			const items = await Promise.all(dataPromises);

			function cleanSnippet(excerpt) {
				if (!excerpt) return '';
				let s = excerpt;

				// 1. Remove UI tool artifacts & buttons
				s = s.replace(/Zitieren\s*Quelle:\s*gesetze-im-internet\.de\s*↗?/gi, ' ');
				s = s.replace(/Quelle:\s*gesetze-im-internet\.de\s*↗?/gi, ' ');
				s = s.replace(/gesetze-im-internet\.de\s*↗?/gi, ' ');
				s = s.replace(/\b(Zitieren|Norm kopieren|Absatz kopieren|Nichtamtliche Fassung|Non-official Translation|Copy Citation|Copy Section)\b/gi, ' ');

				// 2. Separate law abbreviation from paragraph symbol: e.g. "BGB§ 138" -> "BGB § 138"
				s = s.replace(/([A-ZÄÖÜ]{2,})(§+|Art\.?|Artikel)/g, '$1 $2');

				// 3. Separate paragraph/article number from following title word:
				// e.g. "§ 138Sittenwidriges" -> "§ 138 Sittenwidriges", "291Wucher" -> "291 Wucher"
				s = s.replace(/(§+\s*\d+[a-z]?)([A-ZÄÖÜ])/g, '$1 $2');
				s = s.replace(/(Art\.?\s*\d+[a-z]?)([A-ZÄÖÜ])/g, '$1 $2');
				s = s.replace(/(\d+)([A-ZÄÖÜ][a-zäöüß])/g, '$1 $2');
				s = s.replace(/(\d+[a-z])([A-ZÄÖÜ][a-zäöüß])/g, '$1 $2');

				// 4. Separate numbering dots from following text: e.g. "291.§" -> "291. §", "1.für" -> "1. für"
				s = s.replace(/(\d+\.)([§A-Za-zÄÖÜäöüß])/g, '$1 $2');

				// 5. Handle missing spaces across or inside <mark> tags:
				s = s.replace(/(§+\s*\d+[a-z]?)(<mark[^>]*>)/gi, '$1 $2');
				s = s.replace(/(\d+)(<mark[^>]*>[A-Za-zÄÖÜäöüß])/gi, '$1 $2');
				s = s.replace(/(<mark[^>]*>§*\s*\d+)([A-ZÄÖÜ])/g, '$1 $2');
				s = s.replace(/(<mark[^>]*>§*\s*\d+[a-z])([A-ZÄÖÜ])/g, '$1 $2');
				s = s.replace(/(<\/mark>)([A-Za-zÄÖÜäöüß])/gi, '$1 $2');

				// 6. Remove leading breadcrumb repetition if present (e.g. "BGB § 138. § 138..." -> "§ 138...", "291. § 291..." -> "§ 291...")
				s = s.replace(/^[A-ZÄÖÜ0-9_\s]{2,10}\s*§\s*\d+[a-z]?\.\s*(§\s*(?:<mark[^>]*>)?\s*\d+)/i, '$1');
				s = s.replace(/^\d+\.\s*(§\s*(?:<mark[^>]*>)?\s*\d+)/i, '$1');

				// 7. Separate glued punctuation / words if any:
				s = s.replace(/([.!?])(\([0-9a-z]+\))/gi, '$1 $2');
				s = s.replace(/([.!?])([A-Za-zÄÖÜäöüß])/g, '$1 $2');

				// 8. Collapse multiple spaces
				s = s.replace(/\s+/g, ' ').trim();

				return s;
			}

			if (resultsContainer) {
				const resultsHtml = items
					.map(function (item) {
						let title = (item.meta && item.meta.title) || item.raw_url || 'Rechtsnorm';
						// Ensure clear separation between paragraph/article number and title
						title = title.replace(/^(§+\s*\d+[a-z]?)([A-ZÄÖÜ])/g, '$1 $2');
						title = title.replace(/^(Art\.?\s*\d+[a-z]?)([A-ZÄÖÜ])/g, '$1 $2');
						const excerpt = cleanSnippet(item.excerpt || '');
						const cleanUrl = (item.url || '').replace(/\/+$/, '') || '/';
						return '<a href="' + cleanUrl + '" class="search-result-item">' + '<h3 class="search-result-title">' + title + '</h3>' + '<p class="search-result-snippet">' + excerpt + '</p>' + '</a>';
					})
					.join('');

				resultsContainer.innerHTML = directHtml + resultsHtml;
			}
		}

		if (input) {
			let debounceTimer;
			input.addEventListener('input', function () {
				clearTimeout(debounceTimer);
				debounceTimer = window.setTimeout(function () {
					runSearch(input.value);
				}, 150);
			});

			if (clearBtn) {
				clearBtn.addEventListener('click', function () {
					input.value = '';
					runSearch('');
					input.focus();
				});
			}

			const urlParams = new URLSearchParams(window.location.search);
			const initialQuery = urlParams.get('q');
			if (initialQuery) {
				input.value = initialQuery;
				runSearch(initialQuery);
			}
		}
	})();
</script>
