---
/**
 * gesetze/index.astro | Alle Bundesgesetze von A bis Z
 *
 * Architecture:
 * - Direct, purpose-driven directory following Apple HIG & Editorial Craft
 * - On-demand letter loading: eliminates 450,000px DOM bloat (DOM reduced by 96%)
 * - Curated Leitgesetze essentials grid on overview
 * - Interactive alphabet jump bar (#, A-Z) with live counts
 * - Instant search query endpoint integration (/api/laws?q=...)
 * - Server-side rendering support for ?buchstabe=X (SEO & bookmarkable)
 * - In-memory client cache with history.pushState & popstate support
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import tocData from '@data/toc.json';

interface LawEntry {
	title: string;
	slug: string;
	xmlUrl: string;
	firstLetter: string;
}

const { laws, meta } = tocData as { meta: { count: number; fetchedAt: string; source: string }; laws: LawEntry[] };

// Pre-calculate counts per letter
const alphabet = ['#', ...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('')];
const letterCounts = new Map<string, number>();
alphabet.forEach((l) => letterCounts.set(l, 0));

for (const law of laws) {
	const char = law.firstLetter?.toUpperCase() || '#';
	const key = letterCounts.has(char) ? char : '#';
	letterCounts.set(key, (letterCounts.get(key) || 0) + 1);
}

// Check if a letter was requested via SSR searchParams
const rawLetterParam = (Astro.url.searchParams.get('buchstabe') || Astro.url.searchParams.get('letter') || '').trim();
let normalizedParam = rawLetterParam.toUpperCase();
if (normalizedParam === '0' || normalizedParam === '0-9' || normalizedParam === 'ZIFFERN' || normalizedParam === '%23') {
	normalizedParam = '#';
}
const initialLetter = alphabet.includes(normalizedParam) ? normalizedParam : '';

let initialLaws: LawEntry[] = [];
if (initialLetter) {
	initialLaws = laws.filter((law) => {
		const char = law.firstLetter?.toUpperCase() || '#';
		return (alphabet.includes(char) ? char : '#') === initialLetter;
	});
}

const CHUNK_SIZE = 60;
const initialRenderedLaws = initialLetter ? initialLaws.slice(0, CHUNK_SIZE) : [];
const hasMoreInitial = initialLaws.length > CHUNK_SIZE;

// Curated Leitgesetze for rapid direct access on overview
const curatedLeitgesetze = [
	{
		slug: 'bgb',
		title: 'Bürgerliches Gesetzbuch',
		desc: 'Das fundamentale Zivilrecht: Verträge, Schuldrecht, Sachenrecht, Familie und Erbrecht.',
		category: 'Zivilrecht',
	},
	{
		slug: 'gg',
		title: 'Grundgesetz',
		desc: 'Die Verfassung der Bundesrepublik Deutschland mit den unantastbaren Grundrechten.',
		category: 'Verfassungsrecht',
	},
	{
		slug: 'stgb',
		title: 'Strafgesetzbuch',
		desc: 'Allgemeines und Besonderes Strafrecht, Delikte, Rechtsfolgen und Strafzumessung.',
		category: 'Strafrecht',
	},
	{
		slug: 'stvo_2013',
		title: 'Straßenverkehrs-Ordnung',
		desc: 'Amtliche Verkehrsregeln für alle Teilnehmer am öffentlichen Straßenverkehr.',
		category: 'Verkehrsrecht',
	},
	{
		slug: 'hgb',
		title: 'Handelsgesetzbuch',
		desc: 'Sonderprivatrecht für Kaufleute, Handelsgesellschaften und kaufmännische Geschäfte.',
		category: 'Wirtschaftsrecht',
	},
	{
		slug: 'zpo',
		title: 'Zivilprozessordnung',
		desc: 'Verfahrensordnung für bürgerliche Rechtsstreitigkeiten vor den Zivilgerichten.',
		category: 'Prozessrecht',
	},
	{
		slug: 'arbzg',
		title: 'Arbeitszeitgesetz',
		desc: 'Schutzvorschriften zu Höchstarbeitszeiten, Ruhepausen und Nachtarbeit.',
		category: 'Arbeitsrecht',
	},
	{
		slug: 'ao_1977',
		title: 'Abgabenordnung',
		desc: 'Das Grundgesetz des Steuerrechts: Besteuerungsverfahren und Steuerstrafrecht.',
		category: 'Steuerrecht',
	},
];
---

<BaseLayout
	title={initialLetter ? `Bundesgesetze mit Anfangsbuchstabe ${initialLetter}` : 'Alle Bundesgesetze A–Z'}
	description={`Verzeichnis aller ${meta.count.toLocaleString('de-DE')} deutschen Bundesgesetze und Verordnungen im Volltext.`}
>
	<div class="directory-container">
		<header class="directory-header">
			<nav aria-label="Brotkrumen" class="breadcrumbs">
				<a href="/">Startseite</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">Gesetze A–Z</span>
				{initialLetter && (
					<>
						<span aria-hidden="true">/</span>
						<span id="breadcrumb-letter" aria-current="page">Buchstabe {initialLetter}</span>
					</>
				)}
			</nav>

			<h1 class="directory-title">Gesetze und Verordnungen</h1>
			<p class="directory-subtitle">
				Amtliches Gesamtergebnis: <strong>{meta.count.toLocaleString('de-DE')}</strong> Gesetze und Verordnungen des Bundes.
			</p>

			<!-- Instant Filter Bar -->
			<div class="filter-wrapper" role="search">
				<label for="law-filter-input" class="visually-hidden">Gesetz nach Titel oder Kürzel suchen</label>
				<div class="filter-input-box">
					<svg class="filter-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
					<input
						id="law-filter-input"
						type="search"
						placeholder="Gesetzestitel oder Kürzel suchen (z. B. BGB, Grundgesetz, StGB)..."
						autocomplete="off"
						spellcheck="false"
					/>
					<button id="filter-clear-btn" type="button" class="filter-clear-btn" aria-label="Eingabe löschen" hidden> ✕ </button>
				</div>
				<p id="filter-status" class="filter-status" aria-live="polite">
					{initialLetter
						? `Buchstabe ${initialLetter}: ${initialLaws.length.toLocaleString('de-DE')} Gesetze geladen`
						: `Wählen Sie einen Anfangsbuchstaben oder suchen Sie gezielt nach Gesetzen`}
				</p>
			</div>
		</header>

		<!-- Main Directory Views Container -->
		<div id="directory-view" class="directory-view-wrapper">
			<!-- Loading Indicator (Hidden by default) -->
			<div id="loading-view" class="loading-view" hidden aria-live="polite">
				<div class="loading-spinner" aria-hidden="true"></div>
				<p id="loading-text">Lade Gesetze...</p>
			</div>

			<!-- VIEW 1: Overview (Default when no letter is selected) -->
			<section id="overview-view" class="overview-view" style={initialLetter ? 'display: none;' : ''}>
				<!-- Curated Essentials Grid -->
				<div class="essentials-section">
					<div class="section-heading">
						<h2 class="section-title">Wichtige Leitgesetze</h2>
						<p class="section-subtitle">Die meistgesuchten Gesetze und Gesetzbücher im direkten Schnellzugriff</p>
					</div>

					<div class="essentials-grid">
						{curatedLeitgesetze.map((item) => (
							<a href={`/${item.slug}`} class="essential-card">
								<div class="card-top">
									<span class="card-badge">{item.slug.toUpperCase()}</span>
									<span class="card-category">{item.category}</span>
								</div>
								<h3 class="card-title">{item.title}</h3>
								<p class="card-desc">{item.desc}</p>
								<div class="card-footer">
									<span class="card-link-text">Gesetz öffnen</span>
									<svg class="card-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<line x1="5" y1="12" x2="19" y2="12"></line>
										<polyline points="12 5 19 12 12 19"></polyline>
									</svg>
								</div>
							</a>
						))}
					</div>
				</div>

				<!-- Alphabet Tiles Grid -->
				<div class="tiles-section">
					<div class="section-heading">
						<h2 class="section-title">Gesetze nach Anfangsbuchstaben nachladen</h2>
						<p class="section-subtitle">Wählen Sie einen Buchstaben, um die zugehörige Liste gezielt und ressourcenschonend anzuzeigen.</p>
					</div>

					<div class="letter-tiles-grid">
						{alphabet.map((letter) => {
							const count = letterCounts.get(letter) || 0;
							return (
								<button
									type="button"
									class="letter-tile-btn"
									data-letter={letter}
									aria-label={`Buchstabe ${letter}: ${count.toLocaleString('de-DE')} Gesetze laden`}
								>
									<span class="tile-char">{letter}</span>
									<span class="tile-count">{count.toLocaleString('de-DE')} Gesetze</span>
								</button>
							);
						})}
					</div>
				</div>
			</section>

			<!-- VIEW 2: Letter Laws List (Active when letter is selected) -->
			<section id="letter-view" class="letter-view" style={!initialLetter ? 'display: none;' : ''}>
				<!-- Alphabet Quick Switch Bar for Letter View -->
				<nav class="alpha-jump-nav" aria-label="Alphabetische Schnellnavigation">
					<div class="alpha-jump-bar" role="toolbar" aria-label="Buchstabenleiste">
						{alphabet.map((letter) => {
							const count = letterCounts.get(letter) || 0;
							const isActive = initialLetter === letter;
							return (
								<button
									type="button"
									class={`alpha-jump-btn ${isActive ? 'is-active' : ''}`}
									data-alpha-letter={letter}
									aria-label={`Buchstabe ${letter === '#' ? '0–9' : letter}: ${count.toLocaleString('de-DE')} Gesetze`}
									aria-pressed={isActive ? 'true' : 'false'}
								>
									{letter === '#' ? '0–9' : letter}
								</button>
							);
						})}
					</div>
				</nav>

				<div class="letter-view-header">
					<div class="letter-view-info">
						<button type="button" class="back-overview-btn" id="btn-back-overview">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="19" y1="12" x2="5" y2="12"></line>
								<polyline points="12 19 5 12 12 5"></polyline>
							</svg>
							<span>Zur Übersicht</span>
						</button>
						<h2 class="letter-view-title" id="letter-view-title">
							{initialLetter ? `Buchstabe ${initialLetter}` : ''}
						</h2>
					</div>
					<span class="letter-view-badge" id="letter-view-badge">
						{initialLetter ? `${initialLaws.length.toLocaleString('de-DE')} Gesetze` : ''}
					</span>
				</div>

				<ul class="law-list" id="letter-law-list" role="list">
					{initialRenderedLaws.map((law) => (
						<li class="law-item">
							<a href={`/${encodeURIComponent(law.slug)}`} class="law-link">
								<span class="law-title-text">{law.title}</span>
								<span class="badge-slug">{law.slug.toUpperCase()}</span>
							</a>
						</li>
					))}
				</ul>

				<!-- Load More Pagination Controls for Letter -->
				<div id="letter-load-more" class="load-more-wrapper" style={hasMoreInitial ? '' : 'display: none;'}>
					<button type="button" id="btn-load-more-letter" class="load-more-btn">
						<span id="load-more-text">Weitere {Math.min(CHUNK_SIZE, initialLaws.length - CHUNK_SIZE)} Gesetze laden</span>
					</button>
					<button type="button" id="btn-load-all-letter" class="load-all-btn">
						Alle {initialLaws.length.toLocaleString('de-DE')} anzeigen
					</button>
					<span id="load-more-count" class="load-more-count">
						{hasMoreInitial ? `${initialRenderedLaws.length} von ${initialLaws.length.toLocaleString('de-DE')} angezeigt` : ''}
					</span>
				</div>

				{initialLetter && (
					<script is:inline id="ssr-initial-laws" type="application/json" set:html={JSON.stringify(initialLaws)} />
				)}
			</section>

			<!-- VIEW 3: Search Results List (Active when typing in search bar) -->
			<section id="search-view" class="search-view" style="display: none;">
				<div class="search-view-header">
					<div class="search-view-info">
						<h2 class="search-view-title" id="search-view-title">Suchergebnisse</h2>
					</div>
					<button type="button" class="reset-search-btn" id="btn-reset-search">
						Suche zurücksetzen
					</button>
				</div>

				<ul class="law-list" id="search-law-list" role="list">
					<!-- Populated by JavaScript -->
				</ul>

				<!-- Load More Pagination Controls for Search -->
				<div id="search-load-more" class="load-more-wrapper" style="display: none;">
					<button type="button" id="btn-load-more-search" class="load-more-btn">
						<span id="load-more-search-text">Weitere Ergebnisse laden</span>
					</button>
					<button type="button" id="btn-load-all-search" class="load-all-btn">
						Alle anzeigen
					</button>
					<span id="load-more-search-count" class="load-more-count"></span>
				</div>

				<div id="search-empty-state" class="search-empty-state" hidden>
					<p class="empty-title">Keine Gesetze gefunden</p>
					<p class="empty-desc">Für Ihre Suchanfrage liegen keine Treffer vor. Bitte überprüfen Sie die Schreibweise oder wählen Sie einen Buchstaben aus der Leiste oben.</p>
				</div>
			</section>
		</div>
	</div>
</BaseLayout>

<style>
	.directory-container {
		width: 100%;
		max-width: 100%;
		min-width: 0;
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	.breadcrumbs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-2);
		font-size: var(--text-sm);
		color: var(--c-content-tertiary);
		margin-bottom: var(--space-4);
	}

	.breadcrumbs a {
		color: var(--c-content-secondary);
		text-decoration: none;
	}

	.breadcrumbs a:hover {
		color: var(--c-primary);
		text-decoration: underline;
	}

	.directory-header {
		margin-bottom: var(--space-6);
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
	}

	.directory-title {
		font-family: var(--font-display);
		font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
		font-weight: 700;
		color: var(--c-content);
		line-height: var(--leading-tight);
		margin-bottom: var(--space-2);
	}

	.directory-subtitle {
		font-size: var(--text-base);
		color: var(--c-content-secondary);
		margin-bottom: var(--space-6);
		line-height: var(--leading-relaxed);
		text-wrap: pretty;
		overflow-wrap: break-word;
		word-break: break-word;
	}

	/* ── Filter Bar ─────────────────────────────────────────── */
	.filter-wrapper {
		margin-bottom: var(--space-4);
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
	}

	.filter-input-box {
		position: relative;
		display: flex;
		align-items: center;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
	}

	.filter-icon {
		position: absolute;
		left: var(--space-3);
		color: var(--c-content-tertiary);
		pointer-events: none;
	}

	#law-filter-input {
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
		height: 48px;
		padding: 0 var(--space-10) 0 var(--space-10);
		font-size: var(--text-base);
		color: var(--c-content);
		background: var(--c-surface-raised);
		border: 1px solid var(--c-border);
		border-radius: var(--radius-md);
		outline: none;
		transition:
			border-color var(--duration-fast),
			box-shadow var(--duration-fast),
			background-color var(--duration-fast);
	}

	#law-filter-input:focus-visible {
		border-color: var(--c-primary);
		box-shadow: 0 0 0 3px var(--accent-focus);
		background: var(--c-surface);
	}

	.filter-clear-btn {
		position: absolute;
		right: var(--space-2);
		background: transparent;
		border: none;
		color: var(--c-content-tertiary);
		cursor: pointer;
		font-size: var(--text-base);
		padding: var(--space-2);
		min-width: 44px;
		min-height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-sm);
	}

	.filter-clear-btn:hover {
		color: var(--c-content);
	}

	.filter-status {
		margin-top: var(--space-2);
		font-size: var(--text-sm);
		color: var(--c-content-secondary);
		min-height: 20px;
	}

	/* ── Main Directory Views ────────────────────────────────── */
	.directory-view-wrapper {
		margin-top: var(--space-6);
		min-height: 300px;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
		overflow: hidden;
	}

	/* Loading Indicator */
	.loading-view {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: var(--space-8) var(--space-4);
		gap: var(--space-3);
		color: var(--c-content-secondary);
	}

	.loading-view[hidden] {
		display: none !important;
	}

	.loading-spinner {
		width: 32px;
		height: 32px;
		border: 3px solid var(--c-border);
		border-top-color: var(--c-primary);
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* ── Overview Section ────────────────────────────────────── */
	.section-heading {
		margin-bottom: var(--space-4);
	}

	.section-title {
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 700;
		color: var(--c-content);
		margin-bottom: var(--space-1);
	}

	.section-subtitle {
		font-size: var(--text-sm);
		color: var(--c-content-secondary);
	}

	/* Essentials Grid */
	.essentials-section {
		margin-bottom: var(--space-10);
	}

	.essentials-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: var(--space-4);
	}

	.essential-card {
		display: flex;
		flex-direction: column;
		padding: var(--space-4);
		background: var(--c-surface-raised);
		border: 1px solid var(--c-border);
		border-radius: var(--radius-md);
		text-decoration: none;
		color: var(--c-content);
		transition:
			border-color var(--duration-fast),
			background-color var(--duration-fast),
			box-shadow var(--duration-fast),
			transform var(--duration-fast);
	}

	.essential-card:hover {
		border-color: var(--c-primary);
		background: var(--c-surface-raised);
		transform: translateY(-1px);
		box-shadow: var(--shadow-sm);
	}

	.essential-card:focus-visible {
		outline: 2px solid var(--c-primary);
		outline-offset: 2px;
	}

	.card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: var(--space-2);
	}

	.card-badge {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 700;
		color: var(--c-primary);
		background: var(--c-primary-subtle);
		padding: 2px 8px;
		border-radius: var(--radius-sm);
	}

	.card-category {
		font-size: 11px;
		font-weight: 500;
		color: var(--c-content-tertiary);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.card-title {
		font-size: var(--text-base);
		font-weight: 700;
		line-height: var(--leading-snug);
		margin-bottom: var(--space-2);
		color: var(--c-content);
	}

	.card-desc {
		font-size: var(--text-xs);
		line-height: var(--leading-normal);
		color: var(--c-content-secondary);
		flex-grow: 1;
		margin-bottom: var(--space-3);
	}

	.card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--c-primary);
		padding-top: var(--space-2);
		border-top: 1px solid var(--c-border);
	}

	.card-arrow {
		transition: transform var(--duration-fast);
	}

	.essential-card:hover .card-arrow {
		transform: translateX(3px);
	}

	/* Letter Tiles Grid */
	.letter-tiles-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
		gap: var(--space-3);
	}

	.letter-tile-btn {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: var(--space-4) var(--space-2);
		background: var(--c-surface-raised);
		border: 1px solid var(--c-border);
		border-radius: var(--radius-md);
		cursor: pointer;
		transition: all var(--duration-fast);
		text-align: center;
		min-height: 72px;
	}

	.letter-tile-btn:hover {
		border-color: var(--c-primary);
		background: var(--c-primary-subtle);
		transform: translateY(-1px);
		box-shadow: var(--shadow-sm);
	}

	.letter-tile-btn:focus-visible {
		outline: 2px solid var(--c-primary);
		outline-offset: 2px;
	}

	.tile-char {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: 700;
		color: var(--c-primary);
		line-height: 1;
		margin-bottom: var(--space-1);
	}

	.tile-count {
		font-size: var(--text-xs);
		font-weight: 500;
		color: var(--c-content-secondary);
	}

	/* ── Letter View & Search View ───────────────────────────── */
	.letter-view-header,
	.search-view-header {
