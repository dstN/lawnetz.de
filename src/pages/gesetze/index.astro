		.search-view-header {
			flex-direction: column;
			align-items: flex-start;
		}

		.law-link {
			padding: 10px 12px;
			gap: var(--space-2);
		}

		.law-title-text {
			font-size: var(--text-sm);
			line-height: 1.35;
		}
	}
</style>

<script>
	interface LawEntry {
		title: string;
		slug: string;
		xmlUrl: string;
		firstLetter: string;
	}

	const CHUNK_SIZE = 60;

	// DOM Elements
	const filterInput = document.getElementById('law-filter-input') as HTMLInputElement | null;
	const clearBtn = document.getElementById('filter-clear-btn') as HTMLButtonElement | null;
	const filterStatus = document.getElementById('filter-status') as HTMLParagraphElement | null;

	const letterTileBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.letter-tile-btn'));

	const overviewView = document.getElementById('overview-view') as HTMLElement | null;
	const letterView = document.getElementById('letter-view') as HTMLElement | null;
	const searchView = document.getElementById('search-view') as HTMLElement | null;
	const loadingView = document.getElementById('loading-view') as HTMLElement | null;
	const loadingText = document.getElementById('loading-text') as HTMLParagraphElement | null;

	const letterViewTitle = document.getElementById('letter-view-title') as HTMLHeadingElement | null;
	const letterViewBadge = document.getElementById('letter-view-badge') as HTMLSpanElement | null;
	const letterLawList = document.getElementById('letter-law-list') as HTMLUListElement | null;
	const btnBackOverview = document.getElementById('btn-back-overview') as HTMLButtonElement | null;

	const letterLoadMoreDiv = document.getElementById('letter-load-more') as HTMLDivElement | null;
	const btnLoadMoreLetter = document.getElementById('btn-load-more-letter') as HTMLButtonElement | null;
	const btnLoadAllLetter = document.getElementById('btn-load-all-letter') as HTMLButtonElement | null;
	const letterLoadMoreText = document.getElementById('load-more-text') as HTMLSpanElement | null;
	const letterLoadMoreCount = document.getElementById('load-more-count') as HTMLSpanElement | null;

	const searchViewTitle = document.getElementById('search-view-title') as HTMLHeadingElement | null;
	const searchLawList = document.getElementById('search-law-list') as HTMLUListElement | null;
	const searchEmptyState = document.getElementById('search-empty-state') as HTMLDivElement | null;
	const btnResetSearch = document.getElementById('btn-reset-search') as HTMLButtonElement | null;

	const searchLoadMoreDiv = document.getElementById('search-load-more') as HTMLDivElement | null;
	const btnLoadMoreSearch = document.getElementById('btn-load-more-search') as HTMLButtonElement | null;
	const btnLoadAllSearch = document.getElementById('btn-load-all-search') as HTMLButtonElement | null;
	const searchLoadMoreText = document.getElementById('load-more-search-text') as HTMLSpanElement | null;
	const searchLoadMoreCount = document.getElementById('load-more-search-count') as HTMLSpanElement | null;

	// In-memory cache for letters: letter => LawEntry[]
	const alphabet = ['#', ...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('')];
	const cache = new Map<string, LawEntry[]>();
	let currentLetter: string | null = null;

	let currentLetterLaws: LawEntry[] = [];
	let currentLetterShown = 0;

	let currentSearchLaws: LawEntry[] = [];
	let currentSearchShown = 0;

	function appendLaws(container: HTMLUListElement, laws: LawEntry[], start: number, count: number) {
		const fragment = document.createDocumentFragment();
		const slice = laws.slice(start, start + count);

		for (const law of slice) {
			const li = document.createElement('li');
			li.className = 'law-item';

			const a = document.createElement('a');
			a.href = `/${encodeURIComponent(law.slug)}`;
			a.className = 'law-link';

			const titleSpan = document.createElement('span');
			titleSpan.className = 'law-title-text';
			titleSpan.textContent = law.title;

			const badgeSpan = document.createElement('span');
			badgeSpan.className = 'badge-slug';
			badgeSpan.textContent = law.slug.toUpperCase();

			a.appendChild(titleSpan);
			a.appendChild(badgeSpan);
			li.appendChild(a);
			fragment.appendChild(li);
		}

		container.appendChild(fragment);
	}

	function updateLetterLoadMoreUI() {
		if (!letterLoadMoreDiv) return;
		const total = currentLetterLaws.length;
		const remaining = total - currentLetterShown;
		if (remaining <= 0) {
			letterLoadMoreDiv.style.display = 'none';
		} else {
			letterLoadMoreDiv.style.display = 'flex';
			const nextChunk = Math.min(CHUNK_SIZE, remaining);
			if (letterLoadMoreText) letterLoadMoreText.textContent = `Weitere ${nextChunk} Gesetze anzeigen (${remaining} verbleibend)`;
			if (btnLoadAllLetter) btnLoadAllLetter.textContent = `Alle ${total.toLocaleString('de-DE')} anzeigen`;
			if (letterLoadMoreCount) letterLoadMoreCount.textContent = `${currentLetterShown.toLocaleString('de-DE')} von ${total.toLocaleString('de-DE')} angezeigt`;
		}
	}

	function renderLetterLaws(laws: LawEntry[]) {
		currentLetterLaws = laws;
		currentLetterShown = Math.min(CHUNK_SIZE, laws.length);
		if (letterLawList) {
			letterLawList.innerHTML = '';
			appendLaws(letterLawList, laws, 0, currentLetterShown);
		}
		updateLetterLoadMoreUI();
	}

	function updateSearchLoadMoreUI() {
		if (!searchLoadMoreDiv) return;
		const total = currentSearchLaws.length;
		const remaining = total - currentSearchShown;
		if (remaining <= 0) {
			searchLoadMoreDiv.style.display = 'none';
		} else {
			searchLoadMoreDiv.style.display = 'flex';
			const nextChunk = Math.min(CHUNK_SIZE, remaining);
			if (searchLoadMoreText) searchLoadMoreText.textContent = `Weitere ${nextChunk} Treffer anzeigen (${remaining} verbleibend)`;
			if (btnLoadAllSearch) btnLoadAllSearch.textContent = `Alle ${total.toLocaleString('de-DE')} anzeigen`;
			if (searchLoadMoreCount) searchLoadMoreCount.textContent = `${currentSearchShown.toLocaleString('de-DE')} von ${total.toLocaleString('de-DE')} angezeigt`;
		}
	}

	function renderSearchLaws(laws: LawEntry[]) {
		currentSearchLaws = laws;
		currentSearchShown = Math.min(CHUNK_SIZE, laws.length);
		if (searchLawList) {
			searchLawList.innerHTML = '';
			appendLaws(searchLawList, laws, 0, currentSearchShown);
		}
		updateSearchLoadMoreUI();
	}

	const alphaJumpBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.alpha-jump-btn'));
	const alphaBtnAll = document.getElementById('alpha-btn-all') as HTMLButtonElement | null;

	function setActiveAlphaButton(letter: string | null) {
		const key = letter ? letter.toUpperCase() : null;
		alphaJumpBtns.forEach((btn) => {
			const btnLetter = btn.getAttribute('data-alpha-letter');
			const isMatch = key ? btnLetter === key : btn.id === 'alpha-btn-all';
			btn.classList.toggle('is-active', isMatch);
			btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
		});
	}

	if (alphaBtnAll) {
		alphaBtnAll.addEventListener('click', () => {
			showOverview();
		});
	}

	alphaJumpBtns.forEach((btn) => {
		const letter = btn.getAttribute('data-alpha-letter');
		if (letter) {
			btn.addEventListener('click', () => {
				loadLetter(letter);
			});
		}
	});

	// Check if initial letter was rendered by SSR or provided in URL / Hash
	const urlParams = new URLSearchParams(window.location.search);
	let rawParam = urlParams.get('buchstabe') || urlParams.get('letter') || '';
	let letterFromUrl = rawParam.trim().toUpperCase();
	if (letterFromUrl === '0' || letterFromUrl === '0-9' || letterFromUrl === 'ZIFFERN' || letterFromUrl === '%23') {
		letterFromUrl = '#';
	}
	if (!alphabet.includes(letterFromUrl)) {
		letterFromUrl = '';
	}

	// Hash fallback (e.g. /gesetze#b, /gesetze#ziffern, /gesetze#0)
	if (!letterFromUrl && window.location.hash) {
		const hash = window.location.hash.replace(/^#/, '').trim().toUpperCase();
		if (hash === 'ZIFFERN' || hash === '0' || hash === '0-9' || hash === '#' || hash === '%23') {
			letterFromUrl = '#';
		} else if (alphabet.includes(hash)) {
			letterFromUrl = hash;
		}
	}

	if (letterFromUrl) {
		currentLetter = letterFromUrl;
		setActiveAlphaButton(letterFromUrl);
		const ssrDataEl = document.getElementById('ssr-initial-laws');
		if (ssrDataEl && ssrDataEl.textContent) {
			try {
				const laws = JSON.parse(ssrDataEl.textContent) as LawEntry[];
				cache.set(currentLetter, laws);
				currentLetterLaws = laws;
				currentLetterShown = Math.min(CHUNK_SIZE, laws.length);
				updateLetterLoadMoreUI();
			} catch (e) {}
		} else {
			loadLetter(letterFromUrl, false);
		}
	} else {
		setActiveAlphaButton(null);
	}

	window.addEventListener('hashchange', () => {
		const hash = window.location.hash.replace(/^#/, '').trim().toUpperCase();
		let targetLetter = '';
		if (hash === 'ZIFFERN' || hash === '0' || hash === '0-9' || hash === '#' || hash === '%23') {
			targetLetter = '#';
		} else if (alphabet.includes(hash)) {
			targetLetter = hash;
		}
		if (targetLetter) {
			loadLetter(targetLetter, false);
		}
	});

	function showView(view: 'overview' | 'letter' | 'search') {
		if (loadingView) loadingView.hidden = true;

		if (overviewView) overviewView.style.display = view === 'overview' ? '' : 'none';
		if (letterView) letterView.style.display = view === 'letter' ? '' : 'none';
		if (searchView) searchView.style.display = view === 'search' ? '' : 'none';
	}

	async function loadLetter(letter: string, updateHistory = true) {
		const key = letter.toUpperCase();
		currentLetter = key;

		// Clear search input
		if (filterInput) filterInput.value = '';
		if (clearBtn) clearBtn.hidden = true;

		setActiveAlphaButton(key);

		// Update URL
		if (updateHistory) {
			const newUrl = `/gesetze?buchstabe=${encodeURIComponent(key)}`;
			window.history.pushState({ mode: 'letter', letter: key }, '', newUrl);
		}

		// Update page title
		document.title = `Bundesgesetze mit Anfangsbuchstabe ${key} | LawNetz`;

		// If cached, render immediately
		if (cache.has(key)) {
			const laws = cache.get(key)!;
			if (letterViewTitle) letterViewTitle.textContent = `Buchstabe ${key}`;
			if (letterViewBadge) letterViewBadge.textContent = `${laws.length.toLocaleString('de-DE')} Gesetze`;
			renderLetterLaws(laws);
			if (filterStatus) filterStatus.textContent = `Buchstabe ${key}: ${laws.length.toLocaleString('de-DE')} Gesetze geladen`;
			showView('letter');
			return;
		}

		// Show loading indicator
		if (loadingView) loadingView.hidden = false;
		if (loadingText) loadingText.textContent = `Lade Gesetze für Buchstabe ${key}...`;
		if (letterView) letterView.style.display = 'none';
		if (overviewView) overviewView.style.display = 'none';
		if (searchView) searchView.style.display = 'none';

		try {
			const res = await fetch(`/api/laws?letter=${encodeURIComponent(key)}`);
			if (!res.ok) throw new Error(`HTTP ${res.status}`);
			const data = await res.json();
			const laws = (data.laws || []) as LawEntry[];

			cache.set(key, laws);

			if (letterViewTitle) letterViewTitle.textContent = `Buchstabe ${key}`;
			if (letterViewBadge) letterViewBadge.textContent = `${laws.length.toLocaleString('de-DE')} Gesetze`;
			renderLetterLaws(laws);
			if (filterStatus) filterStatus.textContent = `Buchstabe ${key}: ${laws.length.toLocaleString('de-DE')} Gesetze geladen`;

			showView('letter');
		} catch (err) {
			if (filterStatus) filterStatus.textContent = `Fehler beim Laden von Buchstabe ${key}. Bitte erneut versuchen.`;
			showView('overview');
		}
	}

	function showOverview(updateHistory = true) {
		currentLetter = null;
		setActiveAlphaButton(null);

		if (filterInput) filterInput.value = '';
		if (clearBtn) clearBtn.hidden = true;

		if (updateHistory) {
			window.history.pushState({ mode: 'overview' }, '', '/gesetze');
		}

		document.title = 'Alle Bundesgesetze A–Z | LawNetz';
		if (filterStatus) filterStatus.textContent = 'Wählen Sie einen Anfangsbuchstaben oder suchen Sie gezielt nach Gesetzen';

		showView('overview');
	}

	async function performSearch(query: string) {
		const q = query.trim();
		if (!q) {
			if (currentLetter) {
				loadLetter(currentLetter, false);
			} else {
				showOverview(false);
			}
			return;
		}

		if (loadingView) loadingView.hidden = false;
		if (loadingText) loadingText.textContent = `Suche nach „${q}“...`;
		showView('search');

		try {
			const res = await fetch(`/api/laws?q=${encodeURIComponent(q)}`);
			if (!res.ok) throw new Error(`HTTP ${res.status}`);
			const data = await res.json();
			const laws = (data.laws || []) as LawEntry[];

			if (loadingView) loadingView.hidden = true;

			if (searchViewTitle) {
				searchViewTitle.textContent = `Suchergebnisse für „${q}“`;
			}

			if (filterStatus) {
				filterStatus.textContent = `${laws.length.toLocaleString('de-DE')} Treffer für „${q}“ gefunden`;
			}

			if (laws.length === 0) {
				if (searchLawList) searchLawList.innerHTML = '';
				if (searchLoadMoreDiv) searchLoadMoreDiv.style.display = 'none';
				if (searchEmptyState) searchEmptyState.hidden = false;
			} else {
				if (searchEmptyState) searchEmptyState.hidden = true;
				renderSearchLaws(laws);
			}
		} catch (err) {
			if (loadingView) loadingView.hidden = true;
			if (filterStatus) filterStatus.textContent = `Fehler bei der Suche nach „${q}“.`;
		}
	}

	// Event Listeners for Load More
	if (btnLoadMoreLetter) {
		btnLoadMoreLetter.addEventListener('click', () => {
			if (!letterLawList) return;
			const nextCount = Math.min(CHUNK_SIZE, currentLetterLaws.length - currentLetterShown);
			appendLaws(letterLawList, currentLetterLaws, currentLetterShown, nextCount);
			currentLetterShown += nextCount;
			updateLetterLoadMoreUI();
		});
	}

	if (btnLoadAllLetter) {
		btnLoadAllLetter.addEventListener('click', () => {
			if (!letterLawList) return;
			const remaining = currentLetterLaws.length - currentLetterShown;
			appendLaws(letterLawList, currentLetterLaws, currentLetterShown, remaining);
			currentLetterShown = currentLetterLaws.length;
			updateLetterLoadMoreUI();
		});
	}

	if (btnLoadMoreSearch) {
		btnLoadMoreSearch.addEventListener('click', () => {
			if (!searchLawList) return;
			const nextCount = Math.min(CHUNK_SIZE, currentSearchLaws.length - currentSearchShown);
			appendLaws(searchLawList, currentSearchLaws, currentSearchShown, nextCount);
			currentSearchShown += nextCount;
			updateSearchLoadMoreUI();
		});
	}

	if (btnLoadAllSearch) {
		btnLoadAllSearch.addEventListener('click', () => {
			if (!searchLawList) return;
			const remaining = currentSearchLaws.length - currentSearchShown;
			appendLaws(searchLawList, currentSearchLaws, currentSearchShown, remaining);
			currentSearchShown = currentSearchLaws.length;
			updateSearchLoadMoreUI();
		});
	}

	// Event Listeners for Letter Tiles Navigation
	letterTileBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			const letter = btn.getAttribute('data-letter');
			if (letter) {
				loadLetter(letter);
				const directoryView = document.getElementById('directory-view');
				if (directoryView) {
					directoryView.scrollIntoView({ behavior: 'smooth', block: 'start' });
				}
			}
		});
	});

	if (btnBackOverview) {
		btnBackOverview.addEventListener('click', () => {
			showOverview();
		});
	}

	if (btnResetSearch) {
		btnResetSearch.addEventListener('click', () => {
			if (filterInput) filterInput.value = '';
			if (clearBtn) clearBtn.hidden = true;
			if (currentLetter) {
				loadLetter(currentLetter, false);
			} else {
				showOverview(false);
			}
		});
	}

	if (filterInput) {
		let debounceTimer: number | undefined;

		filterInput.addEventListener('input', () => {
			const val = filterInput.value;
			if (clearBtn) clearBtn.hidden = val.length === 0;

			clearTimeout(debounceTimer);
			debounceTimer = window.setTimeout(() => {
				performSearch(val);
			}, 180);
		});

		if (clearBtn) {
			clearBtn.addEventListener('click', () => {
				filterInput.value = '';
				clearBtn.hidden = true;
				if (currentLetter) {
					loadLetter(currentLetter, false);
				} else {
					showOverview(false);
				}
				filterInput.focus();
			});
		}
	}

	// Browser Back / Forward (PopState)
	window.addEventListener('popstate', (event) => {
		const state = event.state;
		if (state && state.mode === 'letter' && state.letter) {
			loadLetter(state.letter, false);
		} else {
			const params = new URLSearchParams(window.location.search);
			const letter = params.get('buchstabe') || params.get('letter');
			if (letter) {
				loadLetter(letter, false);
			} else {
				showOverview(false);
			}
		}
	});
</script>
