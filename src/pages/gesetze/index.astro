		}

		.letter-view-info {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-2);
		}

		.essentials-grid {
			grid-template-columns: 1fr;
		}

		.letter-tiles-grid {
			grid-template-columns: repeat(3, 1fr);
