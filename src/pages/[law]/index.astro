---
/**
 * [law]/index.astro | Inhaltsverzeichnis eines Gesetzes
 *
 * z.B. /bgb/ oder /gg/
 *
 * Zeigt:
 * - Amtliche Titel, Abkürzung, Ausfertigungsdatum, Stand
 * - Vollständige Gliederung (Bücher, Abschnitte, Titel)
 * - Durchsuchbare Liste aller Paragraphen / Artikel
 * - Barrierefreie Tastaturnavigation
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import FlagIcon from '@components/FlagIcon.astro';
import tocData from '@data/toc.json';
import { getLaw, getLawNorms, getLawOutline, hasTranslation } from '../../db/index';
import { lawDefinitions } from '@data/definitions';

const { law: lawParam } = Astro.params;

let law = Astro.props.law;

if (!law && lawParam) {
	const dbLaw = await getLaw(lawParam);
	if (dbLaw) {
		if (dbLaw.slug !== lawParam) {
			return Astro.redirect(`/${dbLaw.slug}`, 301);
		}
		const dbNorms = await getLawNorms(dbLaw.slug);
		// Buch, Abschnitt, Titel … as headings (2.4.10). The level code has three
		// digits a level; the shallowest level of this law is an h2.
		const outline = await getLawOutline(dbLaw.slug);
		const shallowest = Math.min(...outline.map((h) => h.levelCode?.length ?? 3));
		const headingsBefore = Map.groupBy(outline, (h) => h.beforeNorm);
		type TocItem =
			| { type: 'structure'; designation: string | null; title: string | null; level: number }
			| { type: 'norm'; slug: string; identifier: string; title: string };
		const items: TocItem[] = [];
		let previousLevel = 1;
		for (const n of dbNorms) {
			for (const h of headingsBefore.get(n.orderIndex) ?? []) {
				const depth = ((h.levelCode?.length ?? shallowest) - shallowest) / 3;
				// At most one level below the heading before it, should a law skip one
				const level = Math.min(2 + depth, previousLevel + 1, 6);
				previousLevel = level;
				items.push({ type: 'structure', designation: h.designation, title: h.title, level });
			}
			items.push({ type: 'norm', slug: n.normSlug, identifier: n.identifier, title: n.title });
		}
		law = { ...dbLaw, norms: dbNorms, items };
	}
}

if (!law) {
	return new Response(null, { status: 404 });
}

const englishTranslationSlug = await hasTranslation(law.slug);
const definitions = lawDefinitions(law.slug, law.norms ?? [], 'de');
const pageTitle = `${law.abbreviation} | ${law.title} (Nichtamtliches Inhaltsverzeichnis)`;
const normCount = law.norms ? law.norms.length : law.items ? law.items.filter((i: any) => i.type === 'norm').length : 0;
const description = `${law.title} (${law.abbreviation}) im Volltext lesen. ${normCount} Paragrafen/Artikel, nichtamtliche Textfassung.`;
const canonicalUrl = `/${law.slug}`;

const tocEntry = ((tocData as any).laws as any[])?.find((l: any) => l.slug === law.slug);
const pdfFileName = tocEntry?.pdf || `${(law.abbreviation || law.slug).trim().replace(/\s+/g, '_')}.pdf`;
---

<BaseLayout title={pageTitle} description={description} canonical={canonicalUrl}>
	<article class="law-container">
		<!-- Navigation -->
		<nav aria-label="Brotkrumen" class="breadcrumbs">
			<a href="/gesetze" class="back-link" title="Zurück zur Gesetzesübersicht">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
				<span>Gesetze</span>
			</a>
			<span class="bc-sep" aria-hidden="true">/</span>
			<span class="bc-current" aria-current="page">{law.abbreviation}</span>
		</nav>

		<!-- Law Header -->
		<header class="law-header">
			<div class="law-header-eyebrow">
				<span class="law-abbr-pill">{law.abbreviation}</span>
				<span class="law-jurisdiction">Bundesrecht</span>
				<span class="eyebrow-dot" aria-hidden="true">·</span>
				<span class="law-meta-disclaimer">Nichtamtliches Verzeichnis</span>
			</div>

			<h1 class="law-main-title">{law.title}</h1>

			<div class="law-metadata-row">
				{
					law.latestChange && (
						<span class="meta-item">
							<span class="meta-label">Stand:</span> {law.latestChange}
						</span>
					)
				}
				{
					law.enactmentDate && (
						<span class="meta-item">
							<span class="meta-sep" aria-hidden="true">·</span>
							<span class="meta-label">Ausfertigung:</span> {law.enactmentDate}
						</span>
					)
				}
				{
					law.citation && (
						<span class="meta-item">
							<span class="meta-sep" aria-hidden="true">·</span>
							<span class="meta-label">Fundort:</span> <code>{law.citation}</code>
						</span>
					)
				}
				<span class="meta-item">
					<span class="meta-sep" aria-hidden="true">·</span>
					<a href={law.sourceUrl} target="_blank" rel="noopener noreferrer" class="meta-source-link" title="Originalseite auf gesetze-im-internet.de öffnen">
						gesetze-im-internet.de ↗
					</a>
				</span>
				<span class="meta-item">
					<span class="meta-sep" aria-hidden="true">·</span>
					<a href={`https://www.gesetze-im-internet.de/${law.slug}/${encodeURIComponent(pdfFileName)}`} target="_blank" rel="noopener noreferrer" class="meta-source-link" title="Amtliche PDF-Fassung herunterladen">
						PDF ↗
					</a>
				</span>
				<span class="meta-item">
					<span class="meta-sep" aria-hidden="true">·</span>
					<a href={`https://www.gesetze-im-internet.de/${law.slug}/xml.zip`} target="_blank" rel="noopener noreferrer" class="meta-source-link" title="Amtliche Maschinendaten (XML ZIP) herunterladen">
						XML ↗
					</a>
				</span>
				{
					englishTranslationSlug && (
						<span class="meta-item">
							<span class="meta-sep" aria-hidden="true">·</span>
							<a href={`/en/${englishTranslationSlug}`} class="meta-trans-link" title="Official English translation of this statute">
								<FlagIcon country="GB" size={12} />
								<span lang="en">English Translation</span>
							</a>
						</span>
					)
				}
			</div>
		</header>

		{
			definitions.length > 0 && (
				<details class="law-definitions" id="begriffe" open={definitions.length <= 6}>
					<summary class="law-definitions-summary">
						<h2 class="law-definitions-title">Begriffe, die dieses Gesetz bestimmt ({definitions.length})</h2>
					</summary>
					<ul class="law-definitions-list" role="list">
						{definitions.map((d) => (
							<li>
								<a href={`/${law.slug}/${d.normSlug}`} class="definition-link">
									<span class="definition-term">{d.term}</span>
									<span class="definition-norm">{d.identifier}</span>
								</a>
							</li>
						))}
					</ul>
					<p class="law-definitions-note">
						Maßgeblich ist der Gesetzestext: Ein Wort kann an anderer Stelle anders gemeint sein. Mehr im <a href="/glossar">Glossar</a>.
					</p>
				</details>
			)
		}

		<!-- Section Search / Quick Filter -->
		<section class="law-search-box" aria-label="Paragraphen durchsuchen">
			<div class="search-input-wrapper">
				<svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="8"></circle>
					<path d="m21 21-4.3-4.3"></path>
				</svg>
				<label for="norm-search" class="visually-hidden">Paragraph oder Stichwort suchen</label>
				<input id="norm-search" type="search" placeholder={`In ${law.abbreviation} suchen…`} autocomplete="off" spellcheck="false" />
				<span id="norm-count" class="norm-count-badge" aria-live="polite">
					{law.norms.length} Normen
				</span>
			</div>
		</section>

		<!-- Full Outline & Norms -->
		<div id="norm-list-container" class="law-outline">
			{
				law.items.map((item: any) => {
					if (item.type === 'structure') {
						const Heading = `h${item.level ?? 2}` as 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
						return (
							<div class="structure-heading-item">
								<Heading class="structure-title">
									{item.designation && (
										<span class="structure-desig">
											{item.designation}
											{item.title ? (item.designation.endsWith('.') ? ' ' : ': ') : ''}
										</span>
									)}
									{item.title}
								</Heading>
							</div>
						);
					}

					const isSpecial = /inhaltsübersicht|eingangsformel|schlussformel|anhang/i.test(item.identifier);
					const displayTitle = item.title || (isSpecial ? '' : '(Ohne amtliche Überschrift)');

					return (
						<div class="norm-row-item" data-identifier={item.identifier.toLowerCase()} data-title={item.title.toLowerCase()}>
							<a href={`/${law.slug}/${item.slug}`} class="norm-row-link">
								<span class="norm-id">{item.identifier}</span>
								{displayTitle && <span class="norm-title">{displayTitle}</span>}
							</a>
						</div>
					);
				})
			}
		</div>
	</article>
</BaseLayout>

<style>
	.law-container {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	.breadcrumbs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-2);
		font-size: var(--text-xs);
		color: var(--content-tertiary);
		margin-bottom: var(--space-4);
	}

	/* a 44px target (2.5.5); the negative margins keep the breadcrumb line as it was */
	.back-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		color: var(--content-secondary);
		text-decoration: none;
		font-weight: 500;
		padding: 2px 4px;
		margin-left: -4px;
		min-block-size: 44px;
		min-inline-size: 44px;
		margin-block: -10px;
		border-radius: var(--radius-sm);
		transition: color var(--duration-fast);
	}

	.back-link:hover {
		color: var(--accent-default);
	}

	.bc-sep {
		color: var(--border-strong);
	}

	.bc-current {
		color: var(--content-tertiary);
	}

	.law-header {
		border-bottom: 1px solid var(--border-subtle);
		padding-bottom: var(--space-5);
		margin-bottom: var(--space-5);
	}

	.law-header-eyebrow {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-2);
		font-size: var(--text-xs);
		color: var(--content-tertiary);
	}

	.law-abbr-pill {
		display: inline-block;
		padding: 2px 7px;
		background: var(--accent-subtle);
		color: var(--accent-default);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.6875rem;
		border-radius: var(--radius-sm);
		letter-spacing: 0.05em;
	}

	.law-jurisdiction {
		font-weight: 500;
		color: var(--content-secondary);
	}

	.eyebrow-dot {
		color: var(--border-strong);
	}

	.law-meta-disclaimer {
		color: var(--content-tertiary);
	}

	.law-main-title {
		font-family: var(--font-display);
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--c-content);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--space-2);
	}

	@media (max-width: 860px) {
		.law-main-title {
			font-size: var(--text-2xl);
		}
	}

	/*
	 * The source links are 44px targets (2.5.5), so a line of this row is 44px
	 * tall; the negative margins give the extra height back to the title above
	 * and the header padding below.
	 */
	.law-metadata-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0 var(--space-2);
		margin-block: -12px;
		font-size: var(--text-xs);
		color: var(--content-secondary);
		line-height: var(--leading-normal);
	}

	.meta-item {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		min-block-size: 44px;
	}

	.meta-label {
		color: var(--content-tertiary);
		font-weight: 500;
	}

	.meta-sep {
		color: var(--border-strong);
		margin-right: 2px;
	}

	.law-metadata-row code {
		font-family: var(--font-mono);
		background: var(--surface-sunken);
		padding: 1px 5px;
		border-radius: var(--radius-sm);
		font-size: 0.6875rem;
	}

	/* the dotted line was a bottom border; on a 44px box it is an underline */
	.meta-source-link {
		display: inline-flex;
		align-items: center;
		min-block-size: 44px;
		min-inline-size: 44px;
		justify-content: center;
		color: var(--content-secondary);
		text-decoration: underline dotted var(--border-strong);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color var(--duration-fast), text-decoration-color var(--duration-fast);
	}

	.meta-source-link:hover {
		color: var(--accent-default);
		text-decoration-color: var(--accent-default);
	}

	/* 44px tall, its pill drawn 22px high inside an 11px transparent border */
	.meta-trans-link {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		color: var(--accent-default);
		font-weight: 600;
		text-decoration: none;
		padding: 1px 6px;
		min-block-size: 44px;
		border-block: 11px solid transparent;
		background: var(--accent-subtle);
		background-clip: padding-box;
		border-radius: var(--radius-sm) / calc(var(--radius-sm) + 11px);
		transition: background-color var(--duration-fast);
	}

	.meta-trans-link:hover {
		background: color-mix(in srgb, var(--accent-subtle) 80%, var(--accent-default));
		text-decoration: underline;
	}

	/* Terms this law defines (3.1.3); each link is a 44px target (2.5.5) */
	.law-definitions {
		margin-bottom: var(--space-5);
	}

	/* Long lists start folded, so a code like the BGB does not push its contents down */
	.law-definitions-summary {
		min-block-size: 44px;
		padding-block: 10px;
		cursor: pointer;
	}

	.law-definitions-title {
		display: inline;
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: 700;
		color: var(--content-primary);
	}

	.law-definitions-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--space-4);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.definition-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-block-size: 44px;
		font-size: var(--text-sm);
		color: var(--content-primary);
		text-decoration: none;
	}

	.definition-link:hover .definition-term {
		text-decoration: underline;
	}

	.definition-norm {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--accent-default);
	}

	.law-definitions-note {
		font-size: var(--text-xs);
		color: var(--content-tertiary);
		max-inline-size: 80ch;
	}

	/* Search */
	.law-search-box {
		margin-bottom: var(--space-5);
	}

	.search-input-wrapper {
		position: relative;
		display: flex;
		align-items: center;
		width: 100%;
	}

	.search-icon {
		position: absolute;
		left: 14px;
		color: var(--content-tertiary);
		pointer-events: none;
	}

	#norm-search {
		width: 100%;
		height: 44px;
		padding: 0 100px 0 38px;
		font-size: var(--text-sm);
		color: var(--content-primary);
		background: var(--surface-sunken);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-full);
		transition:
			background-color var(--duration-fast),
			border-color var(--duration-fast),
			box-shadow var(--duration-fast);
	}

	#norm-search:focus-visible {
		background: var(--surface-raised);
		border-color: var(--accent-default);
		box-shadow: 0 0 0 3px var(--accent-focus);
	}

	.norm-count-badge {
		position: absolute;
		right: 14px;
		font-size: var(--text-xs);
		font-weight: 500;
		color: var(--content-tertiary);
		pointer-events: none;
		white-space: nowrap;
	}

	/* Outline list */
	.law-outline {
		display: flex;
		flex-direction: column;
	}

	.structure-heading-item {
		margin-top: var(--space-5);
		margin-bottom: var(--space-2);
		padding-top: var(--space-2);
	}

	.structure-title {
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: 700;
		/* 1.4.8: headings like "VIIIa. Gemeinschaftsaufgaben …" wrap like text */
		line-height: 1.5;
		color: var(--content-primary);
		letter-spacing: -0.01em;
	}

	/* Buch, the top level, a step larger; a run of headings stays together */
	h2.structure-title {
		font-size: var(--text-lg);
	}

	.structure-heading-item + .structure-heading-item {
		margin-top: 0;
		padding-top: 0;
	}

	.structure-desig {
		color: var(--content-secondary);
		font-weight: 600;
	}

	.norm-row-item {
		border-radius: var(--radius-sm);
		transition: background-color var(--duration-fast);
	}

	.norm-row-item:hover,
	.norm-row-item:focus-within {
		background: var(--surface-raised);
	}

	.norm-row-link {
		display: flex;
		align-items: baseline;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-3);
		/* 44px (2.5.5); rows were 40px apart by 2px, now they touch */
		min-height: 44px;
		text-decoration: none;
		color: var(--content-primary);
		width: 100%;
		min-width: 0;
		box-sizing: border-box;
	}

	.norm-id {
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: var(--text-xs);
		min-width: 80px;
		flex-shrink: 0;
		color: var(--accent-default);
	}

	.norm-title {
		font-size: var(--text-sm);
		color: var(--content-primary);
		line-height: var(--leading-normal);
		min-width: 0;
		flex: 1;
		word-break: break-word;
		overflow-wrap: break-word;
		/* 1.4.8: at most 80 characters a line */
		max-inline-size: 80ch;
	}

	@media (max-width: 640px) {
		.norm-id {
			min-width: 64px;
			font-size: 0.6875rem;
		}

		.norm-row-link {
			padding: var(--space-2) var(--space-2);
			gap: var(--space-2);
		}
	}

	.norm-row-item.hidden {
		display: none !important;
	}
</style>

<script>
	// A norm page links to the definitions; arriving that way unfolds them.
	const definitionsBox = document.getElementById('begriffe') as HTMLDetailsElement | null;
	if (definitionsBox && location.hash === '#begriffe') definitionsBox.open = true;
	const searchInput = document.getElementById('norm-search') as HTMLInputElement | null;
	const countNotice = document.getElementById('norm-count') as HTMLSpanElement | null;
	const normRows = Array.from(document.querySelectorAll<HTMLElement>('.norm-row-item'));
	const structureHeadings = Array.from(document.querySelectorAll<HTMLElement>('.structure-heading-item'));
	const total = normRows.length;

	if (searchInput) {
		searchInput.addEventListener('input', () => {
			const q = searchInput.value.trim().toLowerCase();
			if (!q) {
				normRows.forEach((r) => r.classList.remove('hidden'));
				structureHeadings.forEach((h) => (h.style.display = ''));
				if (countNotice) countNotice.textContent = `${total} Normen`;
				return;
			}

			let matches = 0;
			normRows.forEach((row) => {
				const id = row.getAttribute('data-identifier') || '';
				const title = row.getAttribute('data-title') || '';
				const hit = id.includes(q) || title.includes(q);
				if (hit) {
					row.classList.remove('hidden');
					matches++;
				} else {
					row.classList.add('hidden');
				}
			});

			// Hide structure headings during search to keep clean list
			structureHeadings.forEach((h) => (h.style.display = 'none'));

			if (countNotice) {
				countNotice.textContent = `${matches} / ${total}`;
			}
		});
	}
</script>
