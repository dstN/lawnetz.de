---
/**
 * FlagIcon.astro — Crisp Vector SVG Flag Icons
 *
 * Uses country-flag-icons package to provide true SVG flags (3:2 ratio)
 * avoiding missing emoji flag support on Windows / Linux browsers.
 */

import flagDE from 'country-flag-icons/string/3x2/DE';
import flagGB from 'country-flag-icons/string/3x2/GB';

interface Props {
	country: 'DE' | 'GB';
	size?: number; // Height in px, default 14px (width will be size * 1.5)
	class?: string;
	title?: string;
}

const { country, size = 14, class: className = '', title } = Astro.props;

const svgString = country.toUpperCase() === 'DE' ? flagDE : flagGB;
const width = Math.round(size * 1.5);
---

<span
	class:list={['flag-icon', `flag-icon--${country.toLowerCase()}`, className]}
	style={`--flag-w: ${width}px; --flag-h: ${size}px;`}
	title={title}
	aria-hidden={title ? undefined : 'true'}
	set:html={svgString}
/>

<style>
	.flag-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--flag-w, 21px);
		height: var(--flag-h, 14px);
		border-radius: 2.5px;
		overflow: hidden;
		flex-shrink: 0;
		vertical-align: middle;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
		line-height: 1;
	}

	:global(html[data-theme='dark']) .flag-icon {
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18);
	}

	.flag-icon :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
