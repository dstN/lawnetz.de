---
/**
 * Footer.astro
 * Site footer with bilingual legal links, accessibility info, and open-source GitHub attribution.
 */

interface Props {
	currentPath?: string;
}

const { currentPath: propPath = '' } = Astro.props;
const currentPath = propPath || Astro.url.pathname || '';
const isEnglish = currentPath.startsWith('/en');
const here = currentPath.replace(/\/+$/, '') || '/';
const currentYear = new Date().getFullYear();

const github = { href: 'https://github.com/dstN/lawnetz.de', label: 'GitHub ↗', external: true };

/** Three small labelled groups read better than nine links in a ragged row. */
const groups: Array<{ id: string; title: string; links: Array<{ href: string; label: string; external?: boolean }> }> =
	isEnglish
		? [
				{
					id: 'footer-legal',
					title: 'Legal',
					links: [
						{ href: '/en/legal-notice', label: 'Legal Notice' },
						{ href: '/en/privacy', label: 'Privacy Policy' },
						{ href: '/en/accessibility', label: 'Accessibility' },
					],
				},
				{
					id: 'footer-help',
					title: 'Help',
					links: [
						{ href: '/en/about', label: 'About & Source' },
						{ href: '/en/glossary', label: 'Glossary' },
						{ href: '/en/keyboard-shortcuts', label: 'Keyboard Shortcuts' },
						{ href: '/en/contact', label: 'Contact' },
					],
				},
				{
					id: 'footer-project',
					title: 'Project',
					links: [{ href: '/en/updates', label: 'Recent Updates' }, github],
				},
			]
		: [
				{
					id: 'footer-legal',
					title: 'Rechtliches',
					links: [
						{ href: '/impressum', label: 'Impressum' },
						{ href: '/datenschutz', label: 'Datenschutz' },
						{ href: '/barrierefreiheit', label: 'Barrierefreiheit' },
					],
				},
				{
					id: 'footer-help',
					title: 'Hilfe',
					links: [
						{ href: '/hinweise', label: 'Hinweise' },
						{ href: '/glossar', label: 'Glossar' },
						{ href: '/tastenkombinationen', label: 'Tastenkombinationen' },
						{ href: '/kontakt', label: 'Kontakt' },
					],
				},
				{
					id: 'footer-project',
					title: 'Projekt',
					links: [{ href: '/aktualitaeten', label: 'Aktualitätendienst' }, github],
				},
			];
---

<footer class="site-footer" role="contentinfo">
	<div class="site-footer__inner">
		<div class="site-footer__info">
			<p class="site-footer__copyright">
				{
					isEnglish ? (
						<>
							© {currentYear} LawNetz | An open-source project on{' '}
							<a href="https://github.com/dstN/lawnetz.de" target="_blank" rel="noopener noreferrer">
								GitHub
							</a>
							.
						</>
					) : (
						<>
							© {currentYear} LawNetz | Ein freies{' '}
							<a href="https://github.com/dstN/lawnetz.de" target="_blank" rel="noopener noreferrer">
								Open-Source-Projekt auf GitHub
							</a>
							.
						</>
					)
				}
			</p>
			<p class="site-footer__source">
				{
					isEnglish ? (
						<>
							Data source:{' '}
							<a href="https://www.gesetze-im-internet.de" target="_blank" rel="noopener noreferrer">
								gesetze-im-internet.de
							</a>{' '}
							(Federal Ministry of Justice).
						</>
					) : (
						<>
							Datenquelle:{' '}
							<a href="https://www.gesetze-im-internet.de" target="_blank" rel="noopener noreferrer">
								gesetze-im-internet.de
							</a>{' '}
							(Bundesministerium der Justiz).
						</>
					)
				}
			</p>
		</div>

		<nav class="site-footer__nav" aria-label={isEnglish ? 'Legal notices and assistance' : 'Rechtliche Hinweise und Hilfe'}>
			{
				groups.map((group) => (
					<div class="site-footer__group">
						<h2 class="site-footer__heading" id={group.id}>
							{group.title}
						</h2>
						<ul class="site-footer__links" role="list" aria-labelledby={group.id}>
							{group.links.map((link) => (
								<li>
									<a
										href={link.href}
										class="site-footer__link"
										target={link.external ? '_blank' : undefined}
										rel={link.external ? 'noopener noreferrer' : undefined}
										aria-current={link.href === here ? 'page' : undefined}
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</nav>
	</div>
</footer>
