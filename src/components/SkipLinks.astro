---
/**
 * SkipLinks.astro
 * Layer 1 of the accessible navigation system.
 * Hidden by default, becomes visible on keyboard focus.
 * Provides direct jumps to main content areas, in the page's language
 * (German skip links on an English page fail 3.1.2 Language of Parts).
 */
const isEnglish = Astro.url.pathname.startsWith('/en');
---

<nav class="skip-links" aria-label={isEnglish ? 'Skip links' : 'Sprungnavigation'}>
  <a href="#main-content" class="skip-link">
    {isEnglish ? 'Skip to content' : 'Zum Inhalt springen'}
  </a>
  <a href="#main-nav" class="skip-link">
    {isEnglish ? 'Skip to navigation' : 'Zur Navigation springen'}
  </a>
</nav>
