# ============================================
# LawNetz Environment Variables
# ============================================
# Kopiere diese Datei nach .env und passe die Werte fuer deine Umgebung an.

# --- Datenbank (MySQL auf Netcup / lokal) ---
# Empfohlen: Eine einzige Verbindungs-URL (reicht vollkommen aus, keine Einzelfelder noetig):
DB_URL=mysql://dbuser:dbpassword@localhost:3306/dbname

# Alternativ (nur noetig falls keine DB_URL verwendet wird):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=dein_db_user
# DB_PASSWORD=dein_db_passwort
# DB_NAME=dein_db_name

# --- Cronjob Absicherung (fuer Plesk URL-Cronjob) ---
# Generiere einen geheimen Zufallsstring, z. B. mit `openssl rand -hex 32` oder
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=exampleSecret

# --- Server / Port (fuer lokalen Start oder Netcup) ---
HOST=0.0.0.0
PORT=4321

# --- Domain & Mail ---
SITE_URL=https://lawnetz.de
CONTACT_EMAIL=info@lawnetz.de
