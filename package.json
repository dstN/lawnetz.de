{
  "name": "lawnetz.de",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node -e \"const fs=require('fs'); if(fs.existsSync('public/pagefind')) fs.cpSync('public/pagefind', 'dist/client/pagefind', {recursive:true});\"",
    "preview": "astro preview",
    "fetch-toc": "npx tsx scripts/fetch-toc.ts",
    "fonts:import": "npx @dstn/fli --font \"Atkinson Hyperlegible, Lexend\" --weight \"400,700\" --format woff2 --framework vanilla --css src/styles/fonts.css",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "scrape:all": "npx tsx scripts/scrape-all.ts",
    "sync:daily": "npx tsx scripts/sync-daily.ts",
    "sync:translations": "npx tsx scripts/fetch-translations-catalog.ts",
    "build:full": "npm run fetch-toc && npm run sync:translations && npm run build",
    "test": "npx tsx scripts/test-a11y-smoke.ts && npx tsx --test scripts/sync-core.test.ts",
    "test:a11y": "npx playwright test",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.12",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.11",
    "country-flag-icons": "^1.6.20",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "mysql2": "^3.24.6"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@dstn/fli": "^2.0.1",
    "@playwright/test": "^1.65.0",
    "drizzle-kit": "^0.31.11",
    "pagefind": "^1.6.0",
    "typescript": "^5.9.3"
  }
}
