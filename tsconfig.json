{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/env.d.ts",
    "src/**/*",
    "scripts/**/*",
    "tests/**/*",
    "astro.config.mjs",
    "playwright.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "scratch",
    "scratch/**/*",
    ".tempmediaStorage",
    ".tempmediaStorage/**/*"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@styles/*": ["src/styles/*"],
      "@data/*": ["src/data/*"],
      "@lib/*": ["src/lib/*"]
    }
  }
}
